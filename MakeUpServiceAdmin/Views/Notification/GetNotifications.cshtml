@using MakeUpServiceAdmin.DTO.NotificationDto

@model IEnumerable<NotificationDto>
@{
    ViewData["Title"] = "Notifications";
}

<style>
    .page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .page-header h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin: 0;
        line-height: 1.2;
    }
    .page-header p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    .notifications-container {
        border: 1px solid rgba(212, 196, 183, 0.5);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border-radius: 0.75rem;
        background-color: var(--color-surface);
        overflow: hidden;
    }

    .notifications-header {
        padding: 1rem 1.5rem;
        background-color: var(--color-surface-container-low);
        border-bottom: 1px solid var(--color-surface-container-highest);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .notifications-header-title {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-on-surface-variant);
    }
    

    .notifications-list {
        display: flex;
        flex-direction: column;
    }
    .notification-item {
        padding: 1.5rem;
        background-color: var(--color-surface);
        border-bottom: 1px solid var(--color-surface-container-highest);
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        transition: background-color 0.2s;
    }
    .notification-item:last-child {
        border-bottom: none;
    }
    .notification-item:hover {
        background-color: var(--color-surface-container-lowest);
    }
    .notification-item.notification-read {
        background-color: var(--color-surface-container-lowest);
    }
    .notification-item.notification-read .notification-icon-wrapper {
        background-color: transparent;
        border: 1px solid rgba(212, 196, 183, 0.4);
    }
    .notification-item.notification-read .notification-icon {
        color: var(--color-on-surface-variant);
        opacity: 0.5;
    }
    .notification-item.notification-read .notification-title {
        font-weight: 500;
        color: var(--color-on-surface-variant);
    }
    .notification-item.notification-read .notification-message {
        opacity: 0.8;
    }
    
    .notification-icon-wrapper {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 9999px;
        background-color: rgba(80, 69, 59, 0.1); /* primary-container approx */
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
    .notification-icon {
        width: 1.25rem;
        height: 1.25rem;
        color: var(--color-primary);
    }

    .notification-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .notification-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-on-surface);
        margin: 0 0 0.25rem 0;
    }
    .notification-message {
        font-size: 0.875rem;
        color: var(--color-on-surface-variant);
        line-height: 1.625;
        margin: 0 0 0.5rem 0;
    }
    .notification-type-badge {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        font-size: 0.625rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background-color: var(--color-surface-container-highest);
        color: var(--color-on-surface);
        border-radius: 9999px;
        align-self: flex-start;
        margin-bottom: 0.5rem;
    }
    .notification-time {
        font-size: 0.625rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: rgba(125, 114, 104, 0.7); /* on-surface-variant approx */
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin: 0;
    }

    .btn-delete-notification {
        padding: 0.5rem;
        color: rgba(125, 114, 104, 0.4);
        background: transparent;
        border: none;
        border-radius: 0.5rem;
        cursor: pointer;
        transition: all 0.2s;
        opacity: 0;
    }
    .notification-item:hover .btn-delete-notification {
        opacity: 1;
    }
    .btn-delete-notification:hover {
        color: var(--color-error);
        background-color: rgba(220, 38, 38, 0.1);
    }

    .empty-state {
        padding: 3rem;
        text-align: center;
        color: rgba(125, 114, 104, 0.6);
        background-color: var(--color-surface);
    }
    
    /* Modal Styles */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 50;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .modal-overlay.active {
        display: flex;
    }
    .modal-content {
        background-color: var(--color-surface);
        border: 1px solid var(--color-outline-variant);
        border-radius: 0.75rem;
        width: 100%;
        max-width: 28rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
        animation: modal-fade-in 0.2s ease-out;
    }
    @@keyframes modal-fade-in {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    .modal-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        background-color: var(--color-surface-container-low);
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .modal-header h3 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        margin: 0;
        color: var(--color-on-surface);
        padding-right: 1rem;
    }
    .modal-close {
        background: transparent;
        border: none;
        color: var(--color-on-surface-variant);
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 0.375rem;
        transition: color 0.2s;
    }
    .modal-close:hover {
        color: var(--color-on-surface);
    }
    .modal-body {
        padding: 1.5rem;
    }
    .modal-footer {
        padding: 1rem 1.5rem;
        border-top: 1px solid var(--color-surface-container-highest);
        display: flex;
        justify-content: flex-end;
    }
</style>

<div class="page-wrapper" id="notifications-root">
    <div class="page-header">
        <h2>System Notifications</h2>
        <p>Alerts and updates regarding the platform.</p>
    </div>

    <div class="glass-card notifications-container">
        <div class="notifications-header">
            <span class="notifications-header-title">Recent Activity</span>
        </div>
        
        <div class="notifications-list">
            @if (Model != null && Model.Any())
            {
                foreach (var notification in Model)
                {
                    <div class="notification-item @(notification.IsRead ? "notification-read" : "")" style="cursor: pointer;" data-id="@notification.NotificationID" data-title="@notification.Title" data-message="@notification.Message" data-type="@notification.Type" data-time="@notification.CreatedAt">
                        <div class="notification-icon-wrapper">
                            <i data-lucide="bell" class="notification-icon"></i>
                        </div>
                        <div class="notification-content">
                            <h4 class="notification-title">@notification.Title</h4>
                            <p class="notification-message">@notification.Message</p>
                            
                            @if (!string.IsNullOrEmpty(notification.Type))
                            {
                                <span class="notification-type-badge">@notification.Type</span>
                            }
                            
                            <p class="notification-time">
                                <i data-lucide="clock" style="width: 0.75rem; height: 0.75rem;"></i> @notification.CreatedAt.ToString("g")
                            </p>
                        </div>
                        
                    </div>
                }
            }
            else
            {
                <div class="empty-state">
                    <i data-lucide="bell-off" style="width: 3rem; height: 3rem; margin: 0 auto 0.75rem auto; opacity: 0.4;"></i>
                    <p style="font-size: 0.875rem; margin: 0;">You're all caught up. No new notifications.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Notification Details Modal -->
<div id="notificationModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modal-notif-title">Notification Title</h3>
            <button type="button" class="modal-close" onclick="closeNotificationModal()">
                <i data-lucide="x" style="width: 1.25rem; height: 1.25rem;"></i>
            </button>
        </div>
        <div class="modal-body">
            <div style="margin-bottom: 1rem;">
                <span id="modal-notif-type" class="notification-type-badge" style="margin-bottom: 0;">System</span>
                <span id="modal-notif-time" class="notification-time" style="display: inline-flex; margin-left: 0.5rem; vertical-align: middle;">
                    <i data-lucide="clock" style="width: 0.75rem; height: 0.75rem;"></i> <span>Just now</span>
                </span>
            </div>
            <p id="modal-notif-message" style="font-size: 0.875rem; color: var(--color-on-surface-variant); line-height: 1.625; white-space: pre-wrap; margin: 0;">
                Message goes here...
            </p>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn-primary" onclick="closeNotificationModal()">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function closeNotificationModal() {
            document.getElementById('notificationModal').classList.remove('active');
            window.location.reload(); // Reload to refresh the list since it was marked as read
        }

        $(document).ready(function() {
            $('.notification-item').on('click', function(e) {
                // Don't trigger if clicking the delete button
                if ($(e.target).closest('.btn-delete-notification').length > 0) return;

                var id = $(this).data('id');

                // Show modal with loading state
                $('#modal-notif-title').text('Loading...');
                $('#modal-notif-message').text('Fetching details...');
                $('#modal-notif-time span').text('');
                $('#modal-notif-type').hide();
                document.getElementById('notificationModal').classList.add('active');

                // AJAX call to mark as read
                $.ajax({
                    url: '/notification/markasread',
                    type: 'POST',
                    data: { notificationID: id },
                    success: function(res) {
                        if (res && res.success && res.data) {
                            var notif = res.data;
                            // handle both camelCase (from JSON) and PascalCase serialization
                            var title = notif.title || notif.Title || '';
                            var message = notif.message || notif.Message || '';
                            var type = notif.type || notif.Type || '';
                            var time = notif.createAt || notif.CreateAt || '';

                            $('#modal-notif-title').text(title);
                            $('#modal-notif-message').text(message);
                            $('#modal-notif-time span').text(time);
                            
                            if (type) {
                                $('#modal-notif-type').text(type).css('display', 'inline-block');
                            } else {
                                $('#modal-notif-type').hide();
                            }
                        } else {
                            $('#modal-notif-title').text('Error');
                            $('#modal-notif-message').text(res.message || 'Failed to load details.');
                        }
                    },
                    error: function(xhr) {
                        $('#modal-notif-title').text('Error');
                        $('#modal-notif-message').text('Failed to load notification details.');
                    }
                });
            });
        });
    </script>
}
