@using MakeUpServiceAdmin.DTO.FeedbackDto
@model MakeUpServiceAdmin.DTO.PaginatedResponse<FeedbackSummaryDto>
@{
    ViewData["Title"] = "Customer Feedback";
}

<style>
    .page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }
    @@media (min-width: 640px) {
        .page-header {
            flex-direction: row;
            align-items: center;
        }
    }

    .header-title-container h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }
    .header-title-container p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    /* Filter Form */
    .filter-form {
        padding: 1rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        background-color: rgba(251, 249, 248, 0.5); /* bg-surface-bright/50 */
    }
    .filter-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: flex-end;
    }
    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .filter-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
    }
    .filter-actions {
        display: flex;
        gap: 0.5rem;
        margin-left: auto;
    }

    /* Table Layout */
    .table-container {
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(212, 196, 183, 0.5);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border-radius: 0.75rem;
        background-color: var(--color-surface);
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .table-th {
        padding: 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
        background-color: var(--color-surface-container-low);
        border-bottom: 1px solid var(--color-surface-container-highest);
    }
    .table-td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--color-surface-container-highest);
        color: var(--color-on-surface);
        background-color: var(--color-surface);
        font-size: 0.875rem;
    }
    
    .table-tr {
        transition: background-color 0.2s;
    }
    .table-tr:hover {
        background-color: var(--color-surface-container-lowest);
    }
    .table-tr:last-child .table-td {
        border-bottom: none;
    }

    .id-column {
        font-family: monospace;
        font-weight: 600;
        color: var(--color-on-surface);
    }
    
    .customer-info {
        display: flex;
        flex-direction: column;
    }
    .customer-name {
        font-weight: 600;
        color: var(--color-on-surface);
    }
    .customer-contact {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
        margin-top: 0.125rem;
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.25rem 0.625rem;
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 9999px;
    }
    .status-resolved { 
        background-color: rgba(34, 197, 94, 0.1); 
        color: rgb(34, 197, 94); 
    }
    .status-pending { 
        background-color: rgba(234, 179, 8, 0.1); 
        color: rgb(234, 179, 8); 
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: rgba(80, 69, 59, 0.6);
    }
</style>

<div class="page-wrapper" id="feedback-root">
    <div class="page-header">
        <div class="header-title-container">
            <h2>Customer Feedbacks</h2>
            <p>Review client feedback and inquiries.</p>
        </div>
    </div>

    <div class="table-container glass-card">
        <form method="get" action="@Url.Action("Feedback", "Feedback")" class="filter-form">
            <div class="filter-grid">
                <div class="filter-group" style="width: 120px;">
                    <label class="filter-label">ID</label>
                    <input type="number" name="FeedbackID" class="input-glow" placeholder="ID" value="@Context.Request.Query["FeedbackID"]">
                </div>
                <div class="filter-group" style="width: 200px;">
                    <label class="filter-label">Customer Name</label>
                    <input type="text" name="Name" class="input-glow" placeholder="Name" value="@Context.Request.Query["Name"]">
                </div>
                <div class="filter-group" style="width: 150px;">
                    <label class="filter-label">Status</label>
                    <select name="IsResolved" class="input-glow">
                        <option value="">All Statuses</option>
                        <option value="true" selected="@(Context.Request.Query["IsResolved"] == "true")">Resolved</option>
                        <option value="false" selected="@(Context.Request.Query["IsResolved"] == "false")">Pending</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary" style="padding: 0.5rem 1rem; height: 2.5rem;">
                        <i data-lucide="search" style="width: 1rem; height: 1rem;"></i> Search
                    </button>
                    <a href="@Url.Action("Feedback", "Feedback")" class="btn-ghost" style="padding: 0.5rem 1rem; height: 2.5rem; display: inline-flex; align-items: center; justify-content: center; text-decoration: none;">
                        <i data-lucide="x" style="width: 1rem; height: 1rem;"></i> Clear
                    </a>
                </div>
            </div>
        </form>
        <table class="data-table">
            <thead>
                <tr>
                    <th class="table-th" style="padding-left: 1.5rem;">ID</th>
                    <th class="table-th">Customer Info</th>
                    <th class="table-th">Title</th>
                    <th class="table-th">Date</th>
                    <th class="table-th">Status</th>
                    <th class="table-th" style="text-align: right; padding-right: 1.5rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Data != null && Model.Data.Any())
                {
                    foreach (var fb in Model.Data)
                    {
                        <tr class="table-tr">
                            <td class="table-td id-column" style="padding-left: 1.5rem;">
                                #@fb.FeedbackID
                            </td>
                            <td class="table-td">
                                <div class="customer-info">
                                    <span class="customer-name">@fb.Name</span>
                                    <span class="customer-contact">
                                        <i data-lucide="phone" style="width: 0.75rem; height: 0.75rem;"></i> @fb.ContactNumber
                                    </span>
                                </div>
                            </td>
                            <td class="table-td">
                                @fb.Title
                            </td>
                            <td class="table-td" style="color: var(--color-on-surface-variant);">
                                @fb.CreatedAt.ToString("MMM dd, yyyy")
                            </td>
                            <td class="table-td">
                                @if (fb.IsResolved.ToLower() == "true" || fb.IsResolved.ToLower() == "yes" || fb.IsResolved == "1" || fb.IsResolved.ToLower() == "resolved")
                                {
                                    <span class="status-badge status-resolved">
                                        <i data-lucide="check-circle" style="width: 0.875rem; height: 0.875rem;"></i> Resolved
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-pending">
                                        <i data-lucide="clock" style="width: 0.875rem; height: 0.875rem;"></i> Pending
                                    </span>
                                }
                            </td>
                            <td class="table-td" style="text-align: right; padding-right: 1.5rem;">
                                <a href="@Url.Action("FeedbackDetails", "Feedback", new { feedbackID = fb.FeedbackID })" class="btn-ghost" style="padding: 0.375rem 0.75rem; font-size: 0.875rem; display: inline-flex; align-items: center; gap: 0.5rem;">
                                    View <i data-lucide="chevron-right" style="width: 1rem; height: 1rem;"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="table-td">
                            <div class="empty-state">
                                <i data-lucide="message-square" style="width: 3rem; height: 3rem; margin: 0 auto 0.75rem auto; opacity: 0.4;"></i>
                                <p style="font-size: 0.875rem; margin: 0;">No feedback records found.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
