@{
    ViewData["Title"] = "Service Unavailable";
}

<style>
    .error-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        width: 100%;
    }
    .error-card {
        max-width: 32rem;
        width: 100%;
        padding: 3rem 2rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }
    .error-icon {
        width: 5rem;
        height: 5rem;
        color: var(--color-error);
        opacity: 0.8;
    }
    .error-title {
        font-family: var(--font-display);
        font-size: 2.5rem;
        color: var(--color-on-background);
        margin: 0;
        line-height: 1.2;
    }
    .error-message {
        font-size: 1rem;
        color: var(--color-on-surface-variant);
        margin: 0;
        line-height: 1.5;
    }
    .error-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
    }
</style>

<div class="error-wrapper">
    <div class="glass-card error-card">
        <i data-lucide="server-off" class="error-icon"></i>
        <div>
            <h1 class="error-title">API Unavailable</h1>
            <p class="error-message">We couldn't connect to the backend services. The target machine actively refused the connection. Please check if the API server is running.</p>
        </div>
        <div class="error-actions">
            <button onclick="window.location.reload()" class="btn-primary">
                <i data-lucide="refresh-cw" style="width: 1rem; height: 1rem;"></i> Try Again
            </button>
            <a href="@Url.Action("Dashboard", "Dashboard")" class="btn-ghost">
                <i data-lucide="home" style="width: 1rem; height: 1rem;"></i> Dashboard
            </a>
        </div>
    </div>
</div>
