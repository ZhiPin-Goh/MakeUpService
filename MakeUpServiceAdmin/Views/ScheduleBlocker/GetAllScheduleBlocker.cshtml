@using MakeUpServiceAdmin.DTO.ScheduleBlockerDto
@model IEnumerable<ScheduleBlockerDto>
@{
    ViewData["Title"] = "Schedule Blockers";
}

<style>
    .page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }
    @@media (min-width: 640px) {
        .page-header {
            flex-direction: row;
            align-items: center;
        }
    }

    .header-title-container h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }
    .header-title-container p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    /* Table Layout */
    .table-container {
        width: 100%;
        overflow-x: auto;
        border: 1px solid rgba(212, 196, 183, 0.5);
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border-radius: 0.75rem;
        background-color: var(--color-surface);
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
    }
    .table-th {
        padding: 1rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
        background-color: var(--color-surface-container-low);
        border-bottom: 1px solid var(--color-surface-container-highest);
    }
    .table-td {
        padding: 1rem;
        vertical-align: middle;
        border-bottom: 1px solid var(--color-surface-container-highest);
        color: var(--color-on-surface);
        background-color: var(--color-surface);
        font-size: 0.875rem;
    }
    
    .table-tr {
        transition: background-color 0.2s;
    }
    .table-tr:hover {
        background-color: var(--color-surface-container-lowest);
    }
    .table-tr:last-child .table-td {
        border-bottom: none;
    }

    .id-column {
        font-family: monospace;
        font-weight: 600;
        color: var(--color-primary);
    }
    .reason-column {
        font-weight: 500;
    }
    .date-info {
        display: flex;
        flex-direction: column;
    }
    .date-main {
        font-weight: 500;
    }
    .date-sub {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
        opacity: 0.8;
        display: flex;
        align-items: center;
        gap: 0.25rem;
        margin-top: 0.125rem;
    }

    .action-btn-group {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
    }
    .action-btn {
        width: 2rem;
        height: 2rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: none;
        background: transparent;
        cursor: pointer;
        transition: all 0.2s;
        color: var(--color-on-surface-variant);
    }
    .action-btn-edit:hover {
        background-color: rgba(80, 69, 59, 0.2); /* primary container approx */
        color: var(--color-primary);
    }
    .action-btn-delete:hover {
        background-color: rgba(220, 38, 38, 0.15); /* error container approx */
        color: var(--color-error);
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
        color: rgba(80, 69, 59, 0.6);
    }

    /* Form Styles */
    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        margin-bottom: 1rem;
    }
    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
    }
    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    /* Modal Styles */
    .modal-overlay {
        display: none; /* hidden by default */
        position: fixed;
        inset: 0;
        z-index: 50;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .modal-overlay.active {
        display: flex;
    }
    .modal-content {
        background-color: var(--color-surface);
        border: 1px solid var(--color-outline-variant);
        border-radius: 0.75rem;
        width: 100%;
        max-width: 28rem;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
        animation: modal-fade-in 0.2s ease-out;
    }
    @@keyframes modal-fade-in {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }
    .modal-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        background-color: var(--color-surface-container-low);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .modal-header h3 {
        font-family: var(--font-display);
        font-size: 1.25rem;
        margin: 0;
        color: var(--color-on-surface);
    }
    .modal-close {
        background: transparent;
        border: none;
        color: var(--color-on-surface-variant);
        cursor: pointer;
        padding: 0.25rem;
        border-radius: 0.375rem;
        transition: color 0.2s;
    }
    .modal-close:hover {
        color: var(--color-on-surface);
    }
    .modal-body {
        padding: 1.5rem;
    }
    .modal-footer {
        padding-top: 1rem;
        border-top: 1px solid var(--color-surface-container-highest);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }
</style>

<div class="page-wrapper" id="blockers-root">
    <div class="page-header">
        <div class="header-title-container">
            <h2>Schedule Blockers</h2>
            <p>Manage off-days, holidays, and blocked time slots.</p>
        </div>
        <button type="button" class="btn-primary" onclick="document.getElementById('blockerModal').classList.add('active')">
            <i data-lucide="plus" style="width: 1rem; height: 1rem;"></i> Add Blocker
        </button>
    </div>

    <div class="table-container glass-card">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="table-th" style="padding-left: 1.5rem;">ID</th>
                    <th class="table-th">Reason / Title</th>
                    <th class="table-th">Blocked Date(s)</th>
                    <th class="table-th" style="text-align: center;">Status</th>
                    <th class="table-th" style="text-align: right; padding-right: 1.5rem;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var blocker in Model)
                    {
                        <tr class="table-tr">
                            <td class="table-td id-column" style="padding-left: 1.5rem;">#@blocker.ScheduleBlockerID</td>
                            <td class="table-td reason-column">@blocker.Reason</td>
                            <td class="table-td">
                                <div class="date-info">
                                    <span class="date-main">@blocker.StartDate.ToString("MMM dd, yyyy tt:hh")</span>
                                    <span class="date-sub">
                                        <i data-lucide="clock" style="width: 0.75rem; height: 0.75rem;"></i> @blocker.EndDate.ToString("MMM dd, yyyy tt:hh")
                                    </span>
                                </div>
                            </td>
                            <td class="table-td" style="text-align: center;">
                                @(blocker.IsFullDay ? "Full Day" : "Partial")
                            </td>
                            <td class="table-td" style="padding-right: 1.5rem;">
                                <div class="action-btn-group">
                                    <button class="action-btn action-btn-delete" title="Delete" data-id="@blocker.ScheduleBlockerID">
                                        <i data-lucide="trash-2" style="width: 1rem; height: 1rem;"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="table-td">
                            <div class="empty-state">
                                <i data-lucide="calendar-off" style="width: 3rem; height: 3rem; margin: 0 auto 0.75rem auto; opacity: 0.4;"></i>
                                <p style="font-size: 0.875rem; margin: 0;">No schedule blockers found.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Blocker Modal -->
<div id="blockerModal" class="modal-overlay">
    <div class="modal-content" style="max-width: 28rem;">
        <div class="modal-header">
            <h3>Add Schedule Blocker</h3>
            <button type="button" class="modal-close" onclick="document.getElementById('blockerModal').classList.remove('active')">
                <i data-lucide="x" style="width: 1.25rem; height: 1.25rem;"></i>
            </button>
        </div>
        <form id="create-blocker-form" class="modal-body">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Reason / Title</label>
                <input type="text" id="Reason" class="input-glow w-full" placeholder="e.g. Public Holiday" required>
            </div>
            <div class="form-row">
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">Start Date</label>
                    <input type="date" id="StartDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="input-glow w-full" required>
                </div>
                <div class="form-group" style="margin-bottom: 0;">
                    <label class="form-label">End Date</label>
                    <input type="date" id="EndDate" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="input-glow w-full" required>
                </div>
            </div>
            <div class="modal-footer" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--color-surface-container-highest);">
                <button type="button" onclick="document.getElementById('blockerModal').classList.remove('active')" class="btn-ghost">Cancel</button>
                <button type="submit" id="btn-save-blocker" class="btn-primary">Save Blocker</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#create-blocker-form').on('submit', function(e) {
                e.preventDefault();
                var payload = {
                    Reason: $('#Reason').val(),
                    StartDate: $('#StartDate').val(),
                    EndDate: $('#EndDate').val()
                };
                
                var $btn = $('#btn-save-blocker');
                var originalText = $btn.text();
                $btn.prop('disabled', true).html('<i data-lucide="loader" style="width: 1rem; height: 1rem; animation: spin 1s linear infinite;"></i> Saving...');
                if (typeof lucide !== 'undefined') lucide.createIcons();
                
                $.ajax({
                    url: '/scheduleblocker/create',
                    type: 'POST',
                    data: JSON.stringify(payload),
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    success: function(res) {
                        if(res.success) {
                            if (typeof window.AppToast !== 'undefined') window.AppToast.success(res.message || "Blocker added successfully.");
                            setTimeout(function(){ window.location.reload(); }, 1000);
                        } else {
                            if (typeof window.AppToast !== 'undefined') window.AppToast.error(res.message || 'Failed to add blocker.');
                            else alert(res.message || 'Failed to add blocker.');
                            $btn.prop('disabled', false).text(originalText);
                        }
                    },
                    error: function(xhr) {
                        if (typeof window.AppToast !== 'undefined') window.AppToast.error('An error occurred. Code: ' + xhr.status);
                        else alert('An error occurred. Code: ' + xhr.status);
                        $btn.prop('disabled', false).text(originalText);
                    }
                });
            });

            $(".action-btn-delete").on('click', function(){
                var id = $(this).data('id');
                if(confirm("Are you sure you want to delete this blocker?")){
                    $.ajax({
                        url: "/scheduleblocker/delete/" + id,
                        type: "DELETE",
                        success: function(res) {
                            if(res.success) {
                                if (typeof window.AppToast !== 'undefined') window.AppToast.success(res.message || "Blocker deleted successfully.");
                                setTimeout(function(){ window.location.reload(); }, 1000);
                            } else {
                                if (typeof window.AppToast !== 'undefined') window.AppToast.error(res.message || 'Failed to delete blocker.');
                                else alert(res.message || 'Failed to delete blocker.');
                            }
                        },
                        error: function(xhr) {
                            if (typeof window.AppToast !== 'undefined') window.AppToast.error('An error occurred. Code: ' + xhr.status);
                            else alert('An error occurred. Code: ' + xhr.status);
                        }
                    });
                }
                else{
                    if (typeof window.AppToast !== 'undefined') window.AppToast.info('Deletion cancelled.');
                }
            });
        });
    </script>
}
