@using MakeUpServiceAdmin.ViewModel.SettingVm
@model dynamic
@{
    ViewData["Title"] = "System Settings";
}

<style>
    .page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .page-header h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin: 0;
        line-height: 1.2;
    }
    .page-header p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    .settings-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
    }
    @@media (min-width: 768px) {
        .settings-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (min-width: 1280px) {
        .settings-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .setting-card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        transition: all 0.3s;
        border: 1px solid var(--color-surface-container-highest);
    }
    .setting-card:hover {
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        transform: translateY(-4px);
    }

    .setting-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }
    .setting-icon-wrapper {
        width: 3rem;
        height: 3rem;
        border-radius: 0.75rem;
        background-color: var(--color-surface-container);
        border: 1px solid rgba(212, 196, 183, 0.5); /* outline-variant/50 */
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-primary);
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        margin-bottom: 1rem;
    }
    .btn-edit-setting {
        padding: 0.5rem;
        color: var(--color-on-surface-variant);
        border-radius: 0.5rem;
        transition: all 0.2s;
        display: inline-flex;
    }
    .btn-edit-setting:hover {
        color: var(--color-primary);
        background-color: rgba(212, 163, 115, 0.2); /* primary-container/20 */
    }

    .setting-key-section {
        flex: 1;
    }
    .setting-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
        color: var(--color-on-surface-variant);
        margin: 0 0 0.25rem 0;
    }
    .setting-key {
        font-size: 1.125rem;
        font-weight: 700;
        font-family: var(--font-display);
        color: var(--color-on-surface);
        word-break: break-word;
        margin: 0;
    }

    .setting-value-section {
        padding-top: 1rem;
        border-top: 1px solid var(--color-surface-container-highest);
    }
    .setting-value-box {
        background-color: var(--color-surface-container-low);
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        font-family: monospace;
        font-size: 0.875rem;
        color: var(--color-on-surface);
        border: 1px solid rgba(212, 196, 183, 0.3); /* outline-variant/30 */
        word-break: break-word;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .empty-state {
        grid-column: 1 / -1;
        padding: 3rem;
        text-align: center;
        color: rgba(125, 114, 104, 0.6);
    }
</style>

<div class="page-wrapper" id="settings-root">
    <div class="page-header">
        <h2>System Settings</h2>
        <p>Configure core application parameters and logic.</p>
    </div>

    <div class="settings-grid">
        @if (Model != null)
        {
            foreach (var setting in Model)
            {
                <div class="glass-card setting-card">
                    <div class="setting-card-header">
                        <div class="setting-icon-wrapper">
                            <i data-lucide="hash" style="width: 1.5rem; height: 1.5rem;"></i>
                        </div>
                        <a href="@Url.Action("GetSettingDetails", "Setting", new { key = setting.Key })" class="btn-edit-setting" title="View Details">
                            <i data-lucide="edit-3" style="width: 1rem; height: 1rem;"></i>
                        </a>
                    </div>
                    
                    <div class="setting-key-section">
                        <p class="setting-label">Setting Key</p>
                        <h3 class="setting-key">@setting.Key</h3>
                    </div>
                    
                    <div class="setting-value-section">
                        <p class="setting-label">Current Value</p>
                        <div class="setting-value-box">
                            @setting.Value
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="glass-card empty-state">
                <i data-lucide="settings" style="width: 3rem; height: 3rem; margin: 0 auto 0.75rem auto; opacity: 0.4;"></i>
                <p style="font-size: 0.875rem; margin: 0;">No settings found. Add one to get started.</p>
            </div>
        }
    </div>
</div>
