@using MakeUpServiceAdmin.DTO.BookingDto
@model dynamic
@{
    ViewData["Title"] = "Booking Management";
}

<style>
    /* Page Layout */
    .page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }
    @@media (min-width: 640px) {
        .page-header {
            flex-direction: row;
            align-items: center;
        }
    }

    .header-title-container h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }
    .header-title-container p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    /* Filter Form */
    .filter-form {
        padding: 1rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        background-color: rgba(251, 249, 248, 0.5);
    }
    .filter-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        align-items: flex-end;
    }
    .filter-group {
        width: 100%;
    }
    @@media (min-width: 640px) {
        .filter-group { width: auto; }
        .filter-input-sm { width: 7rem; }
        .filter-input-md { width: 9rem; }
        .filter-input-lg { width: 10rem; }
    }
    .filter-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
        margin-bottom: 0.25rem;
    }
    .filter-actions {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;
        width: 100%;
    }
    @@media (min-width: 640px) {
        .filter-actions { width: auto; }
    }
    .filter-btn-h { height: 42px; }

    /* Table Container */
    .table-container {
        overflow-x: auto;
    }
    .data-table {
        width: 100%;
        text-align: left;
        border-collapse: collapse;
    }
    .table-head {
        background-color: var(--color-surface-container-low);
        color: var(--color-on-surface-variant);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .table-th {
        padding: 1rem 1.5rem;
        font-weight: 600;
    }
    .table-th-right { text-align: right; }
    .table-th-center { text-align: center; }
    
    .table-row {
        transition: background-color 0.2s;
        border-bottom: 1px solid var(--color-surface-container-highest);
    }
    .table-row:last-child { border-bottom: none; }
    .table-row:hover { background-color: var(--color-surface-container-lowest); }
    
    .table-td { padding: 1rem 1.5rem; }
    .table-td-right { text-align: right; }
    .table-td-center { text-align: center; }

    .id-text {
        font-family: monospace;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--color-primary);
    }
    
    .client-cell {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .client-avatar {
        width: 2rem;
        height: 2rem;
        border-radius: 9999px;
        background-color: rgba(212, 163, 115, 0.2);
        color: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.875rem;
    }
    .client-name {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-on-surface);
        margin: 0;
    }
    .client-phone {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
        margin: 0;
    }
    
    .cell-text {
        font-size: 0.875rem;
        color: var(--color-on-surface);
        font-weight: 500;
        margin: 0;
    }
    .cell-text-truncate {
        max-width: 120px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .cell-price {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-on-surface);
        margin: 0;
    }

    .status-badge {
        display: inline-block;
        padding: 0.25rem 0.625rem;
        font-size: 0.625rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 9999px;
    }
    .status-pending { background-color: var(--color-tertiary-container); color: var(--color-on-tertiary-container); }
    .status-approved { background-color: var(--color-secondary-container); color: var(--color-on-secondary-container); }
    .status-rejected { background-color: var(--color-error-container); color: var(--color-on-error-container); }
    .status-completed { background-color: var(--color-primary-container); color: var(--color-on-primary-container); }
    .status-default { background-color: var(--color-surface-container-highest); color: var(--color-on-surface-variant); }

    .action-cell {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.25rem;
    }
    .action-btn {
        padding: 0.5rem;
        color: var(--color-on-surface-variant);
        border-radius: 0.5rem;
        transition: all 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
    }
    .action-btn-toggle:hover {
        color: var(--color-primary);
        background-color: rgba(212, 163, 115, 0.2);
    }
    .action-btn-view:hover {
        color: var(--color-secondary);
        background-color: rgba(236, 226, 201, 0.2);
    }
    .action-btn i { width: 1rem; height: 1rem; }

    .empty-state {
        padding: 3rem;
        text-align: center;
        color: rgba(80, 69, 59, 0.6);
    }
    .empty-state i {
        width: 3rem;
        height: 3rem;
        margin: 0 auto 0.75rem auto;
        opacity: 0.4;
        display: block;
    }
    .empty-state p {
        font-size: 0.875rem;
        margin: 0;
    }

    /* Pagination */
    .pagination-bar {
        padding: 1rem;
        border-top: 1px solid var(--color-surface-container-highest);
        background-color: rgba(251, 249, 248, 0.5);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        gap: 0.75rem;
    }
    @@media (min-width: 640px) {
        .pagination-bar { flex-direction: row; }
    }
    .pagination-info {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
        margin: 0;
    }
    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .pagination-label {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-on-surface);
        padding: 0 0.5rem;
    }

    /* Modals */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 50;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        padding: 1rem;
    }
    .modal-overlay.is-visible { display: flex; }
    
    .modal-dialog {
        background-color: var(--color-surface);
        border: 1px solid var(--color-outline-variant);
        border-radius: 0.75rem;
        width: 100%;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }
    .modal-dialog-sm { max-width: 24rem; }
    .modal-dialog-md { max-width: 32rem; }

    .modal-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        background-color: var(--color-surface-container-low);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .modal-title {
        font-family: var(--font-display);
        font-size: 1.25rem;
        color: var(--color-on-surface);
        margin: 0;
    }
    .modal-close-btn {
        color: var(--color-on-surface-variant);
        transition: color 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
    }
    .modal-close-btn:hover { color: var(--color-on-surface); }
    
    .modal-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .modal-footer {
        padding: 1rem;
        border-top: 1px solid var(--color-surface-container-highest);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }
    .modal-footer-bg { background-color: rgba(251, 249, 248, 0.5); }

    /* Details Grid generated via JS */
    .details-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }
    .details-header {
        display: flex;
        align-items: center;
        gap: 1rem;
    }
    .details-header-text h4 {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--color-on-surface);
        margin: 0;
    }
    .details-header-text p {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
        margin: 0;
    }
    .details-header-status { margin-left: auto; }
    
    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        font-size: 0.875rem;
    }
    .details-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
        font-weight: 600;
        margin: 0 0 0.125rem 0;
    }
    .details-value { color: var(--color-on-surface); margin: 0; }
    .details-col-span-2 { grid-column: span 2 / span 2; }
    
    .details-pricing {
        border-top: 1px solid var(--color-surface-container-highest);
        padding-top: 1rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .details-travel-fee { font-size: 0.875rem; }
    .details-travel-fee-label { color: var(--color-on-surface-variant); }
    .details-travel-fee-value { font-weight: 600; color: var(--color-on-surface); }
    .details-total-price {
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-primary);
    }
</style>

<div class="page-wrapper" id="bookings-root">
    <div class="page-header">
        <div class="header-title-container">
            <h2>Booking Management</h2>
            <p>View, approve, and manage client appointments.</p>
        </div>
        <a href="@Url.Action("CreateBooking", "Booking")" class="btn-primary" id="btn-open-create">
            <i data-lucide="plus" class="w-4 h-4"></i> Add Booking
        </a>
    </div>

    <div class="glass-card" style="overflow: hidden;">
        <!-- Search Filter Bar -->
        <form id="search-booking-form" class="filter-form">
            <div class="filter-grid">
                <div class="filter-group filter-input-sm">
                    <label class="filter-label">Booking ID</label>
                    <input type="number" name="BookingID" class="input-glow" placeholder="ID">
                </div>
                <div class="filter-group filter-input-sm">
                    <label class="filter-label">Service ID</label>
                    <input type="number" name="ServiceID" class="input-glow" placeholder="Svc ID">
                </div>
                <div class="filter-group filter-input-sm">
                    <label class="filter-label">Area ID</label>
                    <input type="number" name="AreaID" class="input-glow" placeholder="Area">
                </div>
                <div class="filter-group filter-input-lg">
                    <label class="filter-label">Phone</label>
                    <input type="text" name="PhoneNumber" class="input-glow" placeholder="e.g. 0123456789">
                </div>
                <div class="filter-group filter-input-md">
                    <label class="filter-label">Status</label>
                    <select name="Status" class="input-glow">
                        <option value="">All Statuses</option>
                        <option value="Pending">Pending</option>
                        <option value="Approved">Approved</option>
                        <option value="Rejected">Rejected</option>
                        <option value="Completed">Completed</option>
                        <option value="Canceled">Canceled</option>
                    </select>
                </div>
                <div class="filter-group filter-input-lg">
                    <label class="filter-label">Date</label>
                    <input type="date" name="AppointmentDate" class="input-glow">
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary filter-btn-h" id="btn-search">
                        <i data-lucide="search" class="w-4 h-4"></i> Search
                    </button>
                    <button type="button" class="btn-ghost filter-btn-h" id="btn-reset">
                        <i data-lucide="x" class="w-4 h-4"></i> Clear
                    </button>
                </div>
                <!-- Hidden pagination inputs -->
                <input type="hidden" name="PageNumber" id="hid-page-number" value="@(Model?.PageNumber ?? 1)">
                <input type="hidden" name="PageSize" id="hid-page-size" value="@(Model?.PageSize ?? 20)">
            </div>
        </form>

        <!-- Table -->
        <div class="table-container">
            <table class="data-table" id="booking-table">
                <thead>
                    <tr class="table-head">
                        <th class="table-th">ID</th>
                        <th class="table-th">Client</th>
                        <th class="table-th">Service</th>
                        <th class="table-th">Date</th>
                        <th class="table-th">Area</th>
                        <th class="table-th table-th-right">Total</th>
                        <th class="table-th table-th-center">Status</th>
                        <th class="table-th table-th-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="table-body" id="booking-tbody">
                    <!--Order By DESC ID-->
                    @if (Model != null && Model.Data != null)
                    {
                        foreach (var booking in Model.Data)
                        {
                            <tr class="table-row group">
                                <td class="table-td id-text">#@booking.BookingID</td>
                                <td class="table-td">
                                    <div class="client-cell">
                                        <div class="client-avatar">
                                            @(string.IsNullOrEmpty(booking.Name) ? "?" : booking.Name.Substring(0, 1))
                                        </div>
                                        <div>
                                            <p class="client-name">@booking.Name</p>
                                            <p class="client-phone">@booking.PhoneNumber</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="table-td">
                                    <p class="cell-text">@booking.Service</p>
                                </td>
                                <td class="table-td">
                                    <p class="cell-text">@booking.AppointmentDate.ToString("MMM dd, yyyy")</p>
                                </td>
                                <td class="table-td">
                                    <p class="cell-text cell-text-truncate">@(booking.Area ?? "N/A")</p>
                                </td>
                                <td class="table-td table-td-right">
                                    <p class="cell-price">RM @booking.TotalPrice.ToString("N2")</p>
                                </td>
                                <td class="table-td table-td-center">
                                    @{
                                        string statusClass = "status-default";
                                        string st = booking.Status?.ToString() ?? "";
                                        if (st == "Pending") { statusClass = "status-pending"; }
                                        else if (st == "Approved") { statusClass = "status-approved"; }
                                        else if (st == "Rejected" || st == "Cancelled") { statusClass = "status-rejected"; }
                                        else if (st == "Completed") { statusClass = "status-completed"; }
                                    }
                                    <span class="status-badge @statusClass">
                                        @booking.Status
                                    </span>
                                </td>
                                <td class="table-td table-td-right">
                                    <div class="action-cell">
                                        <button class="action-btn action-btn-toggle btn-toggle-status" title="Toggle Status" data-id="@booking.BookingID" data-status="@booking.Status">
                                            <i data-lucide="refresh-cw"></i>
                                        </button>
                                        <button class="action-btn action-btn-toggle btn-update-fee" title="Update Travel Fee" data-id="@booking.BookingID">
                                            <i data-lucide="map-pin"></i>
                                        </button>
                                        <button class="action-btn action-btn-view btn-view-details" title="View Details" data-id="@booking.BookingID">
                                            <i data-lucide="eye"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="table-row">
                            <td colspan="8" class="table-td">
                                <div class="empty-state">
                                    <i data-lucide="calendar-off"></i>
                                    <p>No bookings found. Try adjusting your search filters.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        @{
            int totalCount = (int)(Model?.TotalCount ?? 0);
            int pageNumber = (int)(Model?.PageNumber ?? 1);
            int pageSize   = (int)(Model?.PageSize ?? 20);
            int totalPages  = pageSize > 0 ? (int)Math.Ceiling((double)totalCount / pageSize) : 1;
            if (totalPages < 1) totalPages = 1;
        }
        <div id="pagination-bar" class="pagination-bar">
            <p class="pagination-info" id="pagination-info">
                Showing page <span id="pag-current">@pageNumber</span> of <span id="pag-total">@totalPages</span>
                &middot; <span id="pag-count">@totalCount</span> total records
            </p>
            <div class="pagination-controls">
                <button type="button" id="btn-prev-page" class="btn-ghost" @(pageNumber <= 1 ? "disabled" : "")>
                    <i data-lucide="chevron-left" class="w-4 h-4"></i> Previous
                </button>
                <span class="pagination-label" id="pag-label">@pageNumber / @totalPages</span>
                <button type="button" id="btn-next-page" class="btn-ghost" @(pageNumber >= totalPages ? "disabled" : "")>
                    Next <i data-lucide="chevron-right" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </div>
</div>



<!-- Toggle Status Modal -->
<div id="toggleStatusModal" class="modal-overlay">
    <div class="modal-dialog modal-dialog-sm">
        <div class="modal-header">
            <h3 class="modal-title">Update Booking Status</h3>
        </div>
        <div class="modal-body">
            <input type="hidden" id="toggle-booking-id">
            <div class="filter-group">
                <label class="filter-label">New Status</label>
                <select id="toggle-new-status" class="input-glow">
                    <option value="Approved">Approved</option>
                    <option value="Rejected">Rejected</option>
                    <option value="Completed">Completed</option>
                    <option value="Canceled">Canceled</option>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="btn-cancel-toggle" class="btn-ghost">Cancel</button>
            <button type="button" id="btn-confirm-toggle" class="btn-primary">Update Status</button>
        </div>
    </div>
</div>

<!-- Update Travel Fee Modal -->
<div id="updateTravelFeeModal" class="modal-overlay">
    <div class="modal-dialog modal-dialog-sm">
        <div class="modal-header">
            <h3 class="modal-title">Update Travel Fee</h3>
        </div>
        <div class="modal-body">
            <input type="hidden" id="update-fee-booking-id">
            <div class="filter-group">
                <label class="filter-label">New Travel Fee (RM)</label>
                <input type="number" id="update-new-fee" class="input-glow" placeholder="0.00" step="0.01" min="0">
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" id="btn-cancel-fee" class="btn-ghost">Cancel</button>
            <button type="button" id="btn-confirm-fee" class="btn-primary">Update Fee</button>
        </div>
    </div>
</div>

<!-- Booking Details Modal -->
<div id="detailsModal" class="modal-overlay">
    <div class="modal-dialog modal-dialog-md">
        <div class="modal-header">
            <h3 class="modal-title">Booking Details</h3>
            <button type="button" id="btn-close-details" class="modal-close-btn">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <div class="modal-body" id="details-content" style="padding: 1.5rem;">
            <!-- Content injected dynamically via AJAX -->
        </div>
        <div class="modal-footer modal-footer-bg">
            <button type="button" class="btn-ghost" onclick="$('#detailsModal').removeClass('is-visible')">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // ── Modal open/close helpers ──
            function openModal(id) { $(id).addClass('is-visible'); if (typeof lucide !== 'undefined') lucide.createIcons(); }
            function closeModal(id) { $(id).removeClass('is-visible'); }

            // Toggle Status Modal
            $('#btn-cancel-toggle').on('click', function() { closeModal('#toggleStatusModal'); });

            // Details Modal
            $('#btn-close-details').on('click', function() { closeModal('#detailsModal'); });

            // ── Search helper function (reusable for filters + pagination) ──
            function doSearch() {
                var $btn = $('#btn-search');
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i data-lucide="loader" class="w-4 h-4" style="animation: spin 1s linear infinite;"></i> Searching');
                if (typeof lucide !== 'undefined') lucide.createIcons();

                var qs = $('#search-booking-form').serialize();
                var searchUrl = '/bookings/search?' + qs;

                $.ajax({
                    url: searchUrl,
                    type: 'GET',
                    success: function(html) {
                        var $parsed = $('<div></div>').html(html);
                        // Update table body
                        var newTbody = $parsed.find('#booking-tbody').html();
                        if (newTbody) {
                            $('#booking-tbody').html(newTbody);
                        }
                        // Update pagination info from the response
                        var newCurrent = $parsed.find('#pag-current').text() || '1';
                        var newTotal   = $parsed.find('#pag-total').text() || '1';
                        var newCount   = $parsed.find('#pag-count').text() || '0';
                        $('#pag-current').text(newCurrent);
                        $('#pag-total').text(newTotal);
                        $('#pag-count').text(newCount);
                        $('#pag-label').text(newCurrent + ' / ' + newTotal);

                        // Update button disabled states
                        var cur = parseInt(newCurrent);
                        var tot = parseInt(newTotal);
                        $('#btn-prev-page').prop('disabled', cur <= 1);
                        $('#btn-next-page').prop('disabled', cur >= tot);
                        // Sync hidden page number
                        $('#hid-page-number').val(cur);

                        if (typeof lucide !== 'undefined') lucide.createIcons();
                        window.history.pushState(null, '', searchUrl);
                    },
                    error: function() {
                        if (typeof window.AppToast !== 'undefined') {
                            window.AppToast.error('Search failed. Please try again.');
                        } else {
                            alert('Search failed. Please try again.');
                        }
                    },
                    complete: function() {
                        $btn.prop('disabled', false).html(originalHtml);
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }
                });
            }

            // ── Search form submit ──
            $('#search-booking-form').on('submit', function(e) {
                e.preventDefault();
                $('#hid-page-number').val(1); // Reset to page 1 on new search
                doSearch();
            });

            // ── Pagination: Previous / Next ──
            $('#btn-prev-page').on('click', function() {
                var current = parseInt($('#hid-page-number').val()) || 1;
                if (current > 1) {
                    $('#hid-page-number').val(current - 1);
                    doSearch();
                }
            });
            $('#btn-next-page').on('click', function() {
                var current = parseInt($('#hid-page-number').val()) || 1;
                var total = parseInt($('#pag-total').text()) || 1;
                if (current < total) {
                    $('#hid-page-number').val(current + 1);
                    doSearch();
                }
            });

            // ── Clear / Reset filters ──
            $('#btn-reset').on('click', function() {
                $('#search-booking-form')[0].reset();
                $('#hid-page-number').val(1);
                // Refresh the search results with default filters
                doSearch();
            });

            // ── Toggle Booking Status ──
            $(document).on('click', '.btn-toggle-status', function() {
                var bookingId = $(this).data('id');
                var status = $(this).data('status') || '';
                var currentStatus = status.toLowerCase();

                if (currentStatus === 'completed' || currentStatus === 'canceled' || currentStatus === 'cancelled' || currentStatus === 'rejected') {
                    if (typeof window.AppToast !== 'undefined') {
                        window.AppToast.error('Cannot change status of a ' + status + ' booking.');
                    } else {
                        alert('Cannot change status of a ' + status + ' booking.');
                    }
                    return;
                }

                $('#toggle-booking-id').val(bookingId);
                
                var $select = $('#toggle-new-status');
                $select.empty();
                
                if (currentStatus === 'pending') {
                    $select.append('<option value="Approved">Approved</option>');
                    $select.append('<option value="Rejected">Rejected</option>');
                    $select.append('<option value="Canceled">Canceled</option>');
                } else if (currentStatus === 'approved') {
                    $select.append('<option value="Completed">Completed</option>');
                    $select.append('<option value="Canceled">Canceled</option>');
                    $select.append('<option value="Rejected">Rejected</option>');
                } else {
                    $select.append('<option value="Approved">Approved</option>');
                    $select.append('<option value="Rejected">Rejected</option>');
                    $select.append('<option value="Completed">Completed</option>');
                    $select.append('<option value="Canceled">Canceled</option>');
                }

                openModal('#toggleStatusModal');
            });

            $('#btn-confirm-toggle').on('click', function() {
                var $btn = $(this);
                $btn.prop('disabled', true).text('Updating...');

                var payload = {
                    bookingID: parseInt($('#toggle-booking-id').val()),
                    status: $('#toggle-new-status').val()
                };

                $.ajax({
                    url: '/bookings/toggle-status',
                    type: 'POST',
                    data: JSON.stringify(payload),
                    contentType: 'application/json',
                    success: function(res) {
                        if (res.success) {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.success(res.message || 'Status updated.');
                            }
                            closeModal('#toggleStatusModal');
                            setTimeout(function() { window.location.reload(); }, 800);
                        } else {
                            alert(res.error || res.message || 'Failed to update status.');
                        }
                    },
                    error: function(xhr) {
                        alert('Server error: ' + xhr.status);
                    },
                    complete: function() {
                        $btn.prop('disabled', false).text('Update Status');
                    }
                });
            });

            // ── Update Travel Fee ──
            $('#btn-cancel-fee').on('click', function() { closeModal('#updateTravelFeeModal'); });

            $(document).on('click', '.btn-update-fee', function() {
                var bookingId = $(this).data('id');
                $('#update-fee-booking-id').val(bookingId);
                $('#update-new-fee').val('');
                openModal('#updateTravelFeeModal');
            });

            $('#btn-confirm-fee').on('click', function() {
                var $btn = $(this);
                $btn.prop('disabled', true).text('Updating...');

                var payload = {
                    bookingID: parseInt($('#update-fee-booking-id').val()),
                    newTravelFee: parseFloat($('#update-new-fee').val()) || 0
                };

                $.ajax({
                    url: '/bookings/update-travel-fee',
                    type: 'POST',
                    data: JSON.stringify(payload),
                    contentType: 'application/json',
                    success: function(res) {
                        if (res.success) {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.success(res.message || 'Travel fee updated.');
                            }
                            closeModal('#updateTravelFeeModal');
                            setTimeout(function() { window.location.reload(); }, 800);
                        } else {
                            alert(res.error || res.message || 'Failed to update travel fee.');
                        }
                    },
                    error: function(xhr) {
                        alert('Server error: ' + xhr.status);
                    },
                    complete: function() {
                        $btn.prop('disabled', false).text('Update Fee');
                    }
                });
            });

            // ── View Booking Details ──
            $(document).on('click', '.btn-view-details', function() {
                var bookingId = $(this).data('id');
                if (!bookingId) return;

                // Show modal with loading
                var $modal = $('#detailsModal');
                $('#details-content').html('<div class="empty-state"><i data-lucide="loader" style="animation: spin 1s linear infinite;"></i><p>Loading details...</p></div>');
                openModal('#detailsModal');
                if (typeof lucide !== 'undefined') lucide.createIcons();

                $.ajax({
                    url: '/bookings/details/' + bookingId,
                    type: 'GET',
                    dataType: 'json',
                    success: function(data) {
                        var d = {
                            bookingID:       data.bookingID       ?? data.BookingID       ?? '',
                            name:            data.name            ?? data.Name            ?? '',
                            email:           data.email           ?? data.Email           ?? '',
                            phoneNumber:     data.phoneNumber     ?? data.PhoneNumber     ?? '',
                            appointmentDate: data.appointmentDate ?? data.AppointmentDate ?? '',
                            appointmentTime: data.appointmentTime ?? data.AppointmentTime ?? '',
                            area:            data.area            ?? data.Area            ?? 'N/A',
                            address:         data.address         ?? data.Address         ?? 'N/A',
                            service:         data.service         ?? data.Service         ?? '',
                            servicePrice:    data.servicePrice    ?? data.ServicePrice    ?? 0,
                            totalDurationMinutes: data.totalDurationMinutes ?? data.TotalDurationMinutes ?? 0,
                            travelFee:       data.travelFee       ?? data.TravelFee       ?? 0,
                            totalPrice:      data.totalPrice      ?? data.TotalPrice      ?? 0,
                            status:          data.status          ?? data.Status          ?? ''
                        };

                        var dateStr = '';
                        if (d.appointmentDate) {
                            var dt = new Date(d.appointmentDate);
                            dateStr = dt.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
                        }

                        // Use semantic status badge
                        var statusClass = "status-default";
                        if (d.status === "Pending") statusClass = "status-pending";
                        else if (d.status === "Approved") statusClass = "status-approved";
                        else if (d.status === "Rejected" || d.status === "Cancelled") statusClass = "status-rejected";
                        else if (d.status === "Completed") statusClass = "status-completed";

                        var html = '<div class="details-wrapper">';
                        
                        // Header
                        html += '<div class="details-header">';
                        html += '  <div class="client-avatar">' + (d.name ? d.name.charAt(0) : '?') + '</div>';
                        html += '  <div class="details-header-text">';
                        html += '    <h4>' + d.name + '</h4>';
                        html += '    <p>Booking #' + d.bookingID + '</p>';
                        html += '  </div>';
                        html += '  <div class="details-header-status"><span class="status-badge ' + statusClass + '">' + d.status + '</span></div>';
                        html += '</div>';
                        
                        // Grid info
                        html += '<div class="details-grid">';
                        html += '  <div><p class="details-label">Email</p><p class="details-value">' + d.email + '</p></div>';
                        html += '  <div><p class="details-label">Phone</p><p class="details-value">' + d.phoneNumber + '</p></div>';
                        html += '  <div><p class="details-label">Service</p><p class="details-value">' + d.service + '</p></div>';
                        html += '  <div><p class="details-label">Date</p><p class="details-value">' + dateStr + '</p></div>';
                        html += '  <div><p class="details-label">Time</p><p class="details-value">' + d.appointmentTime + '</p></div>';
                        html += '  <div><p class="details-label">Duration</p><p class="details-value">' + (d.totalDurationMinutes ? d.totalDurationMinutes + ' mins' : 'N/A') + '</p></div>';
                        html += '  <div><p class="details-label">Area</p><p class="details-value">' + d.area + '</p></div>';
                        html += '  <div class="details-col-span-2"><p class="details-label">Address</p><p class="details-value">' + d.address + '</p></div>';
                        html += '</div>';
                        
                        // Pricing
                        html += '<div class="details-pricing">';
                        html += '  <div class="details-travel-fee"><span class="details-travel-fee-label">Service Price:</span> <span class="details-travel-fee-value">RM ' + parseFloat(d.servicePrice).toFixed(2) + '</span></div>';
                        html += '  <div class="details-travel-fee"><span class="details-travel-fee-label">Travel Fee:</span> <span class="details-travel-fee-value">RM ' + parseFloat(d.travelFee).toFixed(2) + '</span></div>';
                        html += '  <div class="details-total-price">RM ' + parseFloat(d.totalPrice).toFixed(2) + '</div>';
                        html += '</div>';
                        
                        html += '</div>';

                        $('#details-content').html(html);
                    },
                    error: function(xhr) {
                        var errHtml = '<div class="empty-state">';
                        errHtml += '<i data-lucide="alert-triangle" style="color: var(--color-error); opacity: 1;"></i>';
                        errHtml += '<p>Failed to load booking details.</p>';
                        errHtml += '<p style="font-size: 0.75rem; margin-top: 0.25rem;">Error: ' + xhr.status + ' ' + (xhr.statusText || '') + '</p>';
                        errHtml += '</div>';
                        $('#details-content').html(errHtml);
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }
                });
            });
            
            // Add a style tag for spin animation since Tailwind animate-spin is removed
            $("<style type='text/css'>@@keyframes spin { 100% { transform: rotate(360deg); } } </style>").appendTo("head");
        });
    </script>
}
