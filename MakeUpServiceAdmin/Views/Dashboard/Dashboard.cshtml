@model MakeUpServiceAdmin.DTO.DashbaordDto.DashboardDto
@{
    ViewData["Title"] = "Dashboard Overview";
}

<style>
    .dashboard-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .dashboard-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }
    @@media (min-width: 640px) {
        .dashboard-header {
            flex-direction: row;
            align-items: flex-end;
        }
    }

    .header-title h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }
    .header-title p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    .header-date-badge {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background-color: var(--color-surface);
        border: 1px solid var(--color-outline-variant);
        border-radius: 0.5rem;
        padding: 0.25rem;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }
    .header-date-btn {
        padding: 0.375rem;
        border-radius: 0.25rem;
        color: var(--color-on-surface-variant);
        transition: background-color 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .header-date-btn:hover {
        background-color: var(--color-surface-container);
    }
    .header-date-text {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-on-surface);
        padding: 0 0.75rem;
    }

    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.5rem;
    }
    @@media (min-width: 640px) { .metrics-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @@media (min-width: 1024px) { .metrics-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (min-width: 1280px) { .metrics-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

    .metric-card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s;
    }
    .metric-card:hover {
        transform: translateY(-0.25rem);
    }
    .metric-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1rem;
    }
    .metric-icon-box {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .icon-box-primary { color: var(--color-primary); background-color: rgba(212, 163, 115, 0.2); }
    .icon-box-tertiary { color: var(--color-tertiary); background-color: rgba(187, 171, 141, 0.2); }
    .icon-box-error { color: var(--color-error); background-color: rgba(255, 218, 214, 0.5); }
    .icon-box-surface { color: var(--color-on-surface); background-color: var(--color-surface-container-highest); }

    .metric-action-badge {
        font-size: 0.75rem;
        font-weight: 600;
        padding: 0.25rem 0.5rem;
        border-radius: 0.25rem;
        background-color: rgba(255, 218, 214, 0.3);
        color: var(--color-error);
    }

    .metric-title {
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--color-on-surface-variant);
        margin-bottom: 0.25rem;
    }
    .metric-value {
        font-family: var(--font-display);
        font-size: 2.25rem;
        color: var(--color-on-background);
        font-weight: 700;
        letter-spacing: -0.025em;
        margin: 0;
    }

    .metric-glow {
        position: absolute;
        right: -2rem;
        top: -2rem;
        width: 6rem;
        height: 6rem;
        background-color: rgba(212, 163, 115, 0.1);
        border-radius: 9999px;
        filter: blur(24px);
        transition: background-color 0.5s;
    }
    .metric-card:hover .metric-glow {
        background-color: rgba(212, 163, 115, 0.2);
    }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.5rem;
    }
    @@media (min-width: 1024px) {
        .content-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    
    .content-col-left {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    @@media (min-width: 1024px) {
        .content-col-left { grid-column: span 2 / span 2; }
    }

    .content-col-right {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .content-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .content-card-header {
        padding: 1.5rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: rgba(251, 249, 248, 0.5);
    }
    .content-card-title {
        font-size: 1.25rem;
        margin: 0;
    }
    .content-card-link {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-primary);
        display: flex;
        align-items: center;
        gap: 0.25rem;
        text-decoration: none;
        transition: color 0.2s;
    }
    .content-card-link:hover { color: var(--color-primary-container); }
    
    .content-card-action-btn {
        color: var(--color-on-surface-variant);
        transition: color 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
    }
    .content-card-action-btn:hover { color: var(--color-on-surface); }

    .content-card-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        background-color: var(--color-surface);
    }

    .appointment-item {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1rem;
        border-radius: 0.75rem;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.2s;
    }
    .appointment-item:hover {
        border-color: rgba(212, 196, 183, 0.4);
        background-color: var(--color-surface-container-lowest);
    }
    .appointment-time-box {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 0.5rem;
        background-color: var(--color-surface-container-low);
        border: 1px solid rgba(212, 196, 183, 0.5);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: var(--color-on-surface);
        transition: all 0.2s;
    }
    .appointment-item:hover .appointment-time-box {
        border-color: rgba(212, 163, 115, 0.5);
        background-color: rgba(125, 86, 45, 0.05);
    }
    .time-box-time {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-primary);
        line-height: 1;
    }
    .time-box-am {
        font-size: 0.625rem;
        font-weight: 500;
        color: var(--color-on-surface-variant);
        text-transform: uppercase;
        margin-top: 0.25rem;
    }
    
    .appointment-details { flex: 1; }
    .appointment-service {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-on-surface);
        margin: 0;
    }
    .appointment-location {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
        margin: 0.125rem 0 0 0;
    }
    
    .appointment-status-box {
        display: none;
        flex-direction: column;
        align-items: flex-end;
        gap: 0.375rem;
    }
    @@media (min-width: 640px) { .appointment-status-box { display: flex; } }

    .status-badge {
        font-size: 0.625rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.125rem 0.625rem;
        border-radius: 9999px;
        background-color: var(--color-secondary-container);
        color: var(--color-on-secondary-container);
    }
    .booking-id {
        font-size: 0.75rem;
        color: var(--color-on-surface-variant);
    }
    
    .empty-state {
        padding: 1.5rem;
        text-align: center;
        color: rgba(80, 69, 59, 0.6);
        font-size: 0.875rem;
    }
    .empty-state i {
        width: 2.5rem;
        height: 2.5rem;
        margin: 0 auto 0.75rem auto;
        opacity: 0.4;
        display: block;
    }

    .service-type-item {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }
    .service-type-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        font-size: 0.875rem;
    }
    .service-type-name {
        font-weight: 600;
        color: var(--color-on-surface);
        transition: color 0.2s;
    }
    .service-type-item:hover .service-type-name {
        color: var(--color-primary);
    }
    .service-type-count {
        font-weight: 700;
        color: var(--color-primary);
    }
    .service-type-label {
        font-size: 0.625rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-weight: 600;
        color: var(--color-on-surface-variant);
        margin-left: 0.25rem;
    }
    
    .progress-bar-container {
        width: 100%;
        background-color: var(--color-surface-container-highest);
        border-radius: 9999px;
        height: 0.625rem;
        overflow: hidden;
        display: flex;
        box-shadow: inset 0 2px 4px 0 rgba(0, 0, 0, 0.05);
    }
    .progress-bar-fill {
        background-color: var(--color-primary-container);
        height: 100%;
        border-radius: 9999px;
        transition: width 1s ease-out;
        position: relative;
        overflow: hidden;
    }
    .progress-bar-shine {
        position: absolute;
        inset: 0;
        background: linear-gradient(to right, transparent, rgba(255,255,255,0.2), transparent);
        transform: translateX(-100%);
    }
    .service-type-item:hover .progress-bar-shine {
        animation: dashboard-shimmer 1.5s infinite;
    }
    @@keyframes dashboard-shimmer {
        100% { transform: translateX(100%); }
    }
</style>

<div class="dashboard-wrapper">
    <!-- Page Header -->
    <header class="dashboard-header">
        <div class="header-title">
            <h2>Dashboard Overview</h2>
            <p>Welcome back. Here's what's happening at the studio today.</p>
        </div>
        <div class="header-date-badge">
            <button class="header-date-btn">
                <i data-lucide="calendar" class="w-4 h-4"></i>
            </button>
            <span class="header-date-text">@DateTime.Now.ToString("MMM dd, yyyy")</span>
        </div>
    </header>

    <!-- Top Metrics Grid -->
    <section class="metrics-grid">
        <!-- Metric Card 1 -->
        <div class="glass-card metric-card">
            <div class="metric-card-top">
                <div class="metric-icon-box icon-box-primary">
                    <i data-lucide="users" class="w-5 h-5"></i>
                </div>
            </div>
            <h3 class="metric-title">Today's Bookings</h3>
            <p class="metric-value">@(Model?.TodayCount ?? 0)</p>
            <div class="metric-glow"></div>
        </div>
        <!-- Metric Card 2 -->
        <div class="glass-card metric-card">
            <div class="metric-card-top">
                <div class="metric-icon-box icon-box-tertiary">
                    <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                </div>
            </div>
            <h3 class="metric-title">Pending Approvals</h3>
            <p class="metric-value">@(Model?.PendingCount ?? 0)</p>
            <div class="metric-glow"></div>
        </div>
        <!-- Metric Card 3 -->
        <div class="glass-card metric-card">
            <div class="metric-card-top">
                <div class="metric-icon-box icon-box-error">
                    <i data-lucide="alert-circle" class="w-5 h-5"></i>
                </div>
                <span class="metric-action-badge">Action Needed</span>
            </div>
            <h3 class="metric-title">Unread Feedback</h3>
            <p class="metric-value">@(Model?.UnreadFeedbackCount ?? 0)</p>
            <div class="metric-glow"></div>
        </div>
        <!-- Metric Card 4 -->
        <div class="glass-card metric-card">
            <div class="metric-card-top">
                <div class="metric-icon-box icon-box-surface">
                    <i data-lucide="dollar-sign" class="w-5 h-5"></i>
                </div>
            </div>
            <h3 class="metric-title">Monthly Revenue</h3>
            <p class="metric-value">RM @(Model?.MonthRevenus.ToString("N2") ?? "0.00")</p>
            <div class="metric-glow"></div>
        </div>
    </section>

    <!-- Content Grid -->
    <section class="content-grid">
        <!-- Left Column -->
        <div class="content-col-left">
            <div class="glass-card content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title">Upcoming Schedule</h3>
                    <a href="@Url.Action("Calendar-Event","Calendar")" class="content-card-link">
                        View Calendar <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </a>
                </div>
                <div class="content-card-body">
                    @if (Model != null && Model.UpComing != null && Model.UpComing.Any())
                    {
                        foreach (var item in Model.UpComing)
                        {
                            <div class="appointment-item">
                                <div class="appointment-time-box">
                                    <span class="time-box-time">@item.AppointmentDate.ToString("hh:mm")</span>
                                    <span class="time-box-am">@item.AppointmentDate.ToString("tt")</span>
                                </div>
                                <div class="appointment-details">
                                    <h4 class="appointment-service">@item.ServiceName</h4>
                                    <p class="appointment-location">@item.LocationAddress</p>
                                </div>
                                <div class="appointment-status-box">
                                    <span class="status-badge">@item.Status</span>
                                    <span class="booking-id">#@item.BookingID</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            No upcoming appointments found.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right Column -->
        <div class="content-col-right">
            <div class="glass-card content-card">
                <div class="content-card-header">
                    <h3 class="content-card-title">Top Service Type</h3>
                    <button class="content-card-action-btn" title="Insights">
                        <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
                    </button>
                </div>
                <div class="content-card-body" style="gap: 1.25rem;">
                    @if (Model != null && Model.TopServicesType != null && Model.TopServicesType.Any())
                    {
                        var maxCount = Model.TopServicesType.Max(x => x.Count);
                        foreach (var service in Model.TopServicesType)
                        {
                            var percentage = maxCount > 0 ? (service.Count * 100.0 / maxCount) : 0;
                            <div class="service-type-item">
                                <div class="service-type-header">
                                    <span class="service-type-name">@service.Type</span>
                                    <span class="service-type-count">@service.Count <span class="service-type-label">bookings</span></span>
                                </div>
                                <div class="progress-bar-container">
                                    <div class="progress-bar-fill" style="width: @percentage%">
                                        <div class="progress-bar-shine"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state" style="padding: 3rem 1.5rem;">
                            <i data-lucide="pie-chart"></i>
                            <p>No service data available yet.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>
