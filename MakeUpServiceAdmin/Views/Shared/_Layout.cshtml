<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shirley Makeup</title>
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237d562d' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08'/%3E%3Cpath d='M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z'/%3E%3C/svg%3E">
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind v4 CDN -->
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @@theme {
        --color-background: #fbf9f8;
        --color-on-background: #1b1c1c;
        --color-surface: #ffffff;
        --color-surface-dim: #dbd9d9;
        --color-surface-bright: #fbf9f8;
        --color-surface-container-lowest: #ffffff;
        --color-surface-container-low: #f5f3f3;
        --color-surface-container: #efeded;
        --color-surface-container-high: #eae8e7;
        --color-surface-container-highest: #e4e2e2;
        --color-on-surface: #1b1c1c;
        --color-on-surface-variant: #50453b;
        --color-inverse-surface: #303030;
        --color-inverse-on-surface: #f2f0f0;
        --color-outline: #82756a;
        --color-outline-variant: #d4c4b7;
        --color-primary: #7d562d;
        --color-on-primary: #ffffff;
        --color-primary-container: #d4a373;
        --color-on-primary-container: #5b3912;
        --color-inverse-primary: #f0bd8b;
        --color-secondary: #645e4b;
        --color-on-secondary: #ffffff;
        --color-secondary-container: #ece2c9;
        --color-on-secondary-container: #6b6450;
        --color-tertiary: #6a5d43;
        --color-on-tertiary: #ffffff;
        --color-tertiary-container: #bbab8d;
        --color-on-tertiary-container: #4b3f28;
        --color-error: #ba1a1a;
        --color-on-error: #ffffff;
        --color-error-container: #ffdad6;
        --color-on-error-container: #93000a;
        --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
        --font-display: "Playfair Display", ui-serif, Georgia, serif;
        }

        body {
            background-color: var(--color-background);
            color: var(--color-on-background);
            font-family: var(--font-sans);
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            margin: 0;
        }

        body *::selection {
            background-color: rgba(212, 163, 115, 0.3);
            color: var(--color-primary);
        }

        h1, h2, h3, h4, h5, h6 {
            font-family: var(--font-display);
            letter-spacing: -0.025em;
            color: var(--color-on-surface);
        }

        /* Core Global Components (Pure CSS) */
        .glass-card {
            background-color: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid var(--color-surface-container-highest);
            border-radius: 0.75rem;
            box-shadow: 0 4px 24px rgba(0,0,0,0.04);
        }

        .input-glow {
            background-color: var(--color-surface);
            border: 1px solid var(--color-outline-variant);
            border-radius: 0.5rem;
            padding: 0.5rem 1rem;
            font-size: 0.875rem;
            color: var(--color-on-surface);
            transition: all 0.2s;
            width: 100%;
            box-sizing: border-box;
        }
        .input-glow::placeholder { color: rgba(80, 69, 59, 0.5); }
        .input-glow:focus {
            border-color: var(--color-primary-container);
            outline: none;
            box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.15);
        }

        .btn-primary {
            background-color: var(--color-primary-container);
            color: var(--color-on-primary-container);
            font-weight: 600;
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            border: none;
            cursor: pointer;
            transition: all 0.15s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            text-decoration: none;
        }
        .btn-primary:hover {
            background-color: var(--color-primary);
            color: var(--color-on-primary);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .btn-primary:active { transform: scale(0.98); }

        .btn-ghost {
            background-color: transparent;
            border: 1px solid var(--color-outline-variant);
            color: var(--color-on-surface-variant);
            font-weight: 600;
            font-size: 0.875rem;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: all 0.15s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
        }
        .btn-ghost:hover {
            background-color: var(--color-surface-container);
        }
        .btn-ghost:active { transform: scale(0.98); }
        .btn-full { width: 100%; box-sizing: border-box; }

        /* Layout Structure CSS */
        .layout-root {
            min-height: 100vh;
            display: flex;
        }

        .layout-sidebar {
            position: fixed;
            left: 0;
            top: 0;
            height: 100vh;
            background-color: var(--color-background);
            border-right: 1px solid var(--color-outline-variant);
            z-index: 50;
            padding-top: 1.5rem;
            padding-bottom: 1.5rem;
            display: flex;
            flex-direction: column;
            width: 260px;
            transition: transform 0.3s ease-in-out;
            transform: translateX(-100%);
        }
        .layout-sidebar.sidebar-open { transform: translateX(0); }
        @@media (min-width: 768px) {
            .layout-sidebar { transform: translateX(0); }
        }

        .sidebar-brand-container {
            padding: 0 1.5rem;
            margin-bottom: 2rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            position: relative;
        }
        .sidebar-logo {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 9999px;
            background-color: var(--color-surface);
            border: 1px solid var(--color-outline-variant);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.75rem;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }
        .sidebar-logo i { color: var(--color-primary); width: 1.25rem; height: 1.25rem; }
        .sidebar-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--color-primary);
            line-height: 1;
            margin: 0;
        }
        .sidebar-subtitle {
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--color-on-surface-variant);
            opacity: 0.7;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin: 0.25rem 0 0 0;
        }
        .sidebar-close-btn {
            position: absolute;
            top: 0.25rem;
            right: 1rem;
            padding: 0.5rem;
            color: var(--color-on-surface-variant);
            transition: all 0.2s;
            border-radius: 0.5rem;
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .sidebar-close-btn:hover {
            color: var(--color-primary);
            background-color: var(--color-surface-container);
        }
        @@media (min-width: 768px) {
            .sidebar-close-btn { display: none; }
        }

        .sidebar-action {
            padding: 0 1.5rem;
            margin-bottom: 2rem;
        }

        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            padding: 0 0.75rem;
        }
        .sidebar-nav-list {
            display: flex;
            flex-direction: column;
            gap: 0.25rem;
            list-style: none;
            padding: 0;
            margin: 0;
        }
        .nav-item-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            color: var(--color-on-surface-variant);
            opacity: 0.7;
            transition: all 0.15s;
            text-decoration: none;
        }
        .nav-item-link:hover {
            background-color: var(--color-surface-container);
            opacity: 1;
            color: var(--color-on-surface);
        }
        .nav-item-link i { width: 1.25rem; height: 1.25rem; }
        .nav-item-text { font-size: 0.875rem; }

        .sidebar-footer {
            padding: 1rem 0.75rem 0;
            margin-top: auto;
            border-top: 1px solid rgba(212, 196, 183, 0.5);
        }
        .nav-item-logout {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            color: var(--color-error);
            opacity: 0.8;
            transition: background-color 0.2s;
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .nav-item-logout:hover {
            background-color: rgba(255, 218, 214, 0.5);
        }
        .nav-item-logout i { width: 1rem; height: 1rem; }
        .nav-item-logout span { font-size: 0.875rem; font-weight: 500; }

        .layout-main-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            transition: all 0.3s;
            margin-left: 0;
        }
        @@media (min-width: 768px) {
            .layout-main-wrapper { margin-left: 260px; }
        }

        .layout-topbar {
            height: 72px;
            background-color: rgba(251, 249, 248, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--color-outline-variant);
            position: fixed;
            top: 0;
            right: 0;
            left: 0;
            z-index: 40;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
            transition: all 0.3s;
        }
        @@media (min-width: 768px) {
            .layout-topbar { left: 260px; }
        }

        .topbar-section {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .mobile-menu-btn {
            padding: 0.5rem;
            color: var(--color-on-surface-variant);
            transition: background-color 0.2s;
            border-radius: 0.5rem;
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .mobile-menu-btn:hover { background-color: var(--color-surface-container); }
        @@media (min-width: 768px) { .mobile-menu-btn { display: none; } }

        .topbar-icon-btn {
            position: relative;
            padding: 0.5rem;
            color: var(--color-on-surface-variant);
            transition: background-color 0.2s;
            border-radius: 0.5rem;
            background: transparent;
            border: none;
            cursor: pointer;
        }
        .topbar-icon-btn:hover { background-color: var(--color-surface-container); }
        .topbar-icon-btn i { width: 1.25rem; height: 1.25rem; }
        .notification-badge {
            position: absolute;
            top: 0;
            right: 0;
            min-width: 1rem;
            height: 1rem;
            background-color: var(--color-error);
            color: white;
            border-radius: 9999px;
            font-size: 0.625rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.25rem;
            display: none; /* hidden if 0 */
        }
        .topbar-divider {
            width: 1px;
            height: 1.5rem;
            background-color: var(--color-outline-variant);
            display: none;
        }
        @@media (min-width: 640px) { .topbar-divider { display: block; } }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .user-info {
            display: none;
            text-align: right;
        }
        @@media (min-width: 640px) { .user-info { display: block; } }
        .user-name {
            font-size: 0.875rem;
            font-weight: 600;
            color: var(--color-on-surface);
            line-height: 1;
            margin: 0 0 0.25rem 0;
        }
        .user-role {
            font-size: 0.625rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--color-on-surface-variant);
            font-weight: 500;
            margin: 0;
        }
        .user-avatar {
            width: 2.25rem;
            height: 2.25rem;
            border-radius: 9999px;
            background-color: var(--color-primary-container);
            color: var(--color-on-primary-container);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-family: var(--font-display);
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        }

        .layout-content {
            flex: 1;
            margin-top: 72px;
            padding: 1.5rem;
            overflow-x: hidden;
        }
        @@media (min-width: 768px) {
            .layout-content { padding: 2.5rem; }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="layout-root">

        <!-- Sidebar -->
        <aside id="sidebar" class="layout-sidebar">
            <div class="sidebar-brand-container">
                <div class="sidebar-logo">
                    <i data-lucide="brush"></i>
                </div>
                <h1 class="sidebar-title">Shirley Makeup</h1>
                <p class="sidebar-subtitle">Admin Portal</p>
                <button id="close-sidebar" class="sidebar-close-btn">
                    <i data-lucide="x"></i>
                </button>
            </div>
            <div class="sidebar-action">
                <a href="@Url.Action("CreateBooking", "Booking")" class="btn-primary btn-full">
                    <i data-lucide="plus" class="w-4 h-4"></i> Add Booking
                </a>
            </div>
            <nav class="sidebar-nav">
                <ul class="sidebar-nav-list">
                    <li><a href="@Url.Action("Dashboard", "Dashboard")" class="nav-item-link"><i data-lucide="layout-dashboard"></i> <span class="nav-item-text">Dashboard</span></a></li>
                    <li><a href="@Url.Action("SearchBooking", "Booking")" class="nav-item-link"><i data-lucide="calendar"></i> <span class="nav-item-text">Bookings</span></a></li>
                    <li><a href="@Url.Action("CalendarEvent", "Calendar")" class="nav-item-link"><i data-lucide="calendar-days"></i> <span class="nav-item-text">Calendar</span></a></li>
                    <li><a href="@Url.Action("SearchService", "MakeUp")" class="nav-item-link"><i data-lucide="brush"></i> <span class="nav-item-text">Services</span></a></li>
                    <li><a href="@Url.Action("GetAreas", "Area")" class="nav-item-link"><i data-lucide="map-pin"></i> <span class="nav-item-text">Areas</span></a></li>
                    <li><a href="@Url.Action("GetAllBanners", "Banner")" class="nav-item-link"><i data-lucide="image"></i> <span class="nav-item-text">Banners</span></a></li>
                    <li><a href="@Url.Action("calculateTravelFee", "Fee")" class="nav-item-link"><i data-lucide="map-pin"></i> <span class="nav-item-text">Travel Fees</span></a></li>
                    <li><a href="@Url.Action("GetAllScheduleBlocker", "ScheduleBlocker")" class="nav-item-link"><i data-lucide="shield-alert"></i> <span class="nav-item-text">Blockers</span></a></li>
                    <li><a href="@Url.Action("Feedback", "Feedback")" class="nav-item-link"><i data-lucide="message-square"></i> <span class="nav-item-text">Feedbacks</span></a></li>
                    <li><a href="@Url.Action("GetNotifications", "Notification")" class="nav-item-link"><i data-lucide="bell"></i> <span class="nav-item-text">Notifications</span></a></li>
                    <li><a href="@Url.Action("GetSettings", "Setting")" class="nav-item-link"><i data-lucide="settings"></i> <span class="nav-item-text">Settings</span></a></li>
                </ul>
            </nav>
            <div class="sidebar-footer">
                <ul class="sidebar-nav-list">
                    <li>
                        <button id="logout" class="nav-item-logout">
                            <i data-lucide="log-out"></i>
                            <span>Logout</span>
                        </button>
                    </li>
                </ul>
            </div>
        </aside>

        <div class="layout-main-wrapper">
            <!-- Header -->
            <header class="layout-topbar">
                <div class="topbar-section">
                    <button id="mobile-menu-btn" class="mobile-menu-btn">
                        <i data-lucide="menu"></i>
                    </button>
                </div>
                <div class="topbar-section">
                    <button class="topbar-icon-btn" id="notification-btn">
                        <i data-lucide="bell"></i><span id="unread-badge" class="notification-badge"></span>
                    </button>
                    <div class="topbar-divider"></div>
                    <div class="user-profile">
                        <div class="user-info">
                            <p class="user-name">Admin User</p>
                            <p class="user-role">Manager</p>
                        </div>
                        <div class="user-avatar">
                            A
                        </div>
                    </div>
                </div>
            </header>

            <main class="layout-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ui-alerts.js"></script>
    <script>
        lucide.createIcons();
        $('#mobile-menu-btn').on('click', function() {
            $('#sidebar').addClass('sidebar-open');
        });
        $('#close-sidebar').on('click', function() {
            $('#sidebar').removeClass('sidebar-open');
        });

        $('#logout').on('click', function(){
            $.ajax({
                url: '@Url.Action("Logout", "Auth")',
                type: 'POST',
                success: function(response) {
                    window.location.href = '@Url.Action("Login", "Auth")';
                },
                error: function(xhr, status, error) {
                    if (xhr.status === 200 || xhr.status === 0) {
                        window.location.href = '@Url.Action("Login", "Auth")';
                    } else {
                        alert('Logout failed. Please try again.');
                    }
                }
            })
        })

        $('#notification-btn').on('click', function(){
            window.location.href = '@Url.Action("GetNotifications", "Notification")'
        });

        // Fetch unread notification count
        $(document).ready(function() {
            $.ajax({
                url: '/notification/unreadcount',
                type: 'GET',
                success: function(res) {
                    if (res && typeof res.count !== 'undefined') {
                        if (res.count > 0) {
                            $('#unread-badge').text(res.count).css('display', 'flex');
                        } else {
                            $('#unread-badge').hide();
                        }
                    }
                },
                error: function() {
                    console.error('Failed to load notification count.');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
