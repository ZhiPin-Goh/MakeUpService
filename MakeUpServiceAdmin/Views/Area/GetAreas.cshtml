@using MakeUpServiceAdmin.DTO.AreaDto
@model IEnumerable<GetAreaDto>
@{
    ViewData["Title"] = "Area Management";
}

<style>
    /* Page Layout */
    .page-wrapper {
        max-width: 1440px;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .page-header {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
    }
    @@media (min-width: 640px) {
        .page-header {
            flex-direction: row;
            align-items: center;
        }
    }

    .header-title-container h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
        line-height: 1.2;
    }
    .header-title-container p {
        color: var(--color-on-surface-variant);
        font-size: 0.875rem;
        margin: 0;
    }

    /* Grid Layout */
    .area-grid {
        display: grid;
        grid-template-columns: repeat(1, minmax(0, 1fr));
        gap: 1.5rem;
    }
    @@media (min-width: 768px) {
        .area-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @@media (min-width: 1024px) {
        .area-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }

    /* Area Card */
    .area-card {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: all 0.3s;
        position: relative;
        overflow: hidden;
    }

    .area-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 1.5rem;
    }

    .area-icon-box {
        width: 3rem;
        height: 3rem;
        border-radius: 9999px;
        background-color: rgba(236, 226, 201, 0.3); /* secondary-container/30 */
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--color-secondary);
    }

    .status-badge {
        display: inline-block;
        padding: 0.25rem 0.625rem;
        font-size: 0.625rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 9999px;
    }
    .status-active { background-color: var(--color-primary-container); color: var(--color-on-primary-container); }
    .status-inactive { background-color: var(--color-error-container); color: var(--color-on-error-container); }
    .status-default { background-color: var(--color-secondary-container); color: var(--color-on-secondary-container); }

    .area-id {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
    }
    .area-name {
        font-family: var(--font-display);
        font-size: 1.25rem;
        color: var(--color-on-surface);
        margin-bottom: 0.25rem;
    }
    .area-fee-info {
        font-size: 0.875rem;
        color: var(--color-on-surface-variant);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .area-fee-amount {
        color: var(--color-primary);
        font-weight: 700;
    }

    .area-card-footer {
        padding-top: 1rem;
        margin-top: 1.5rem;
        border-top: 1px solid var(--color-surface-container-highest);
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .action-btn {
        padding: 0.5rem;
        color: var(--color-on-surface-variant);
        border-radius: 0.5rem;
        transition: all 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
        display: inline-flex;
        z-index: 10;
    }
    .action-btn:hover {
        color: var(--color-primary);
        background-color: rgba(212, 163, 115, 0.2);
    }
    
    .card-glow {
        position: absolute;
        right: 0;
        bottom: 0;
        width: 6rem;
        height: 6rem;
        background-color: rgba(175, 155, 115, 0.05); /* secondary/5 */
        border-radius: 9999px;
        filter: blur(1.5rem);
        pointer-events: none;
    }

    /* Modals */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 50;
        align-items: center;
        justify-content: center;
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(4px);
        padding: 1rem;
    }
    .modal-overlay.is-visible { display: flex; }
    
    .modal-dialog {
        background-color: var(--color-surface);
        border: 1px solid var(--color-outline-variant);
        border-radius: 0.75rem;
        width: 100%;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }
    .modal-dialog-sm { max-width: 24rem; }
    .modal-dialog-md { max-width: 28rem; }

    .modal-header {
        padding: 1.25rem;
        border-bottom: 1px solid var(--color-surface-container-highest);
        background-color: var(--color-surface-container-low);
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .modal-title {
        font-family: var(--font-display);
        font-size: 1.25rem;
        color: var(--color-on-surface);
        margin: 0;
    }
    .modal-close-btn {
        color: var(--color-on-surface-variant);
        transition: color 0.2s;
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
    }
    .modal-close-btn:hover { color: var(--color-on-surface); }
    
    .modal-body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .modal-footer {
        padding: 1rem;
        border-top: 1px solid var(--color-surface-container-highest);
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }
    .form-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
    }
</style>

<div class="page-wrapper" id="areas-root">
    <div class="page-header">
        <div class="header-title-container">
            <h2>Service Areas</h2>
            <p>Manage coverage zones and specific travel fees.</p>
        </div>
        <a href="@Url.Action("CreateArea", "Area")" class="btn-primary">
            <i data-lucide="plus" style="width: 1rem; height: 1rem;"></i> Add Area
        </a>
    </div>

    <div class="area-grid">
        @if (Model != null)
        {
            foreach (var area in Model)
            {
                <div class="glass-card area-card group">
                    <div class="area-card-header">
                        <div class="area-icon-box">
                            <i data-lucide="map-pin" style="width: 1.5rem; height: 1.5rem;"></i>
                        </div>
                        @{
                            string statusClass = "status-default";
                            if (area.Status == "Active") statusClass = "status-active";
                            else if (area.Status == "Inactive") statusClass = "status-inactive";
                        }
                        <span class="status-badge @statusClass">
                            @area.Status
                        </span>
                    </div>
                    <div>
                        <h4 class="area-id">Area ID: @area.AreaID</h4>
                        <h3 class="area-name">@area.Name</h3>
                        <p class="area-fee-info">
                            <i data-lucide="car" style="width: 1rem; height: 1rem;"></i> Travel Fee: <strong class="area-fee-amount">RM @area.BasePrice</strong>
                        </p>
                    </div>
                    <div class="area-card-footer">
                        <button class="action-btn btn-toggle-status" title="Toggle Status" data-id="@area.AreaID">
                            <i data-lucide="refresh-cw" style="width: 1rem; height: 1rem;"></i>
                        </button>
                        <button class="action-btn btn-edit-area" title="Edit Area" data-id="@area.AreaID" data-name="@area.Name" data-fee="@area.BasePrice">
                            <i data-lucide="edit-2" style="width: 1rem; height: 1rem;"></i>
                        </button>
                    </div>
                    <div class="card-glow"></div>
                </div>
            }
        }
    </div>
</div>

<div id="toggleStatusModal" class="modal-overlay">
    <div class="modal-dialog modal-dialog-sm">
        <div class="modal-header">
            <h3 class="modal-title">Confirm Action</h3>
        </div>
        <div class="modal-body">
            <p style="font-size: 0.875rem; color: var(--color-on-surface-variant); margin: 0;">Toggle status for this service?</p>
            <input type="hidden" id="toggle-service-id">
        </div>
        <div class="modal-footer">
            <button type="button" id="btn-cancel-toggle" class="btn-ghost">Cancel</button>
            <button type="button" id="btn-confirm-toggle" class="btn-primary">Confirm</button>
        </div>
    </div>
</div>

<div id="updateAreaModal" class="modal-overlay">
    <div class="modal-dialog modal-dialog-md">
        <div class="modal-header">
            <h3 class="modal-title">Edit Service Area</h3>
            <button type="button" id="btn-close-update" class="modal-close-btn">
                <i data-lucide="x" style="width: 1.25rem; height: 1.25rem;"></i>
            </button>
        </div>
        <form id="form-update-area" style="margin: 0;">
            <div class="modal-body">
                <input type="hidden" id="update-area-id" name="AreaID">
                <div class="form-group">
                    <label class="form-label">Area Name</label>
                    <input type="text" id="update-area-name" name="Name" class="input-glow w-full" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Base Fee (RM)</label>
                    <input type="number" id="update-area-fee" name="BaseFee" class="input-glow w-full" step="0.01" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" id="btn-cancel-update" class="btn-ghost">Cancel</button>
                <button type="submit" id="btn-submit-update" class="btn-primary">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Modal helpers
            function openModal(id) { $(id).addClass('is-visible'); if (typeof lucide !== 'undefined') lucide.createIcons(); }
            function closeModal(id) { $(id).removeClass('is-visible'); }

            $('#btn-cancel-toggle').on('click', function() { closeModal('#toggleStatusModal'); });
            $('#btn-cancel-update, #btn-close-update').on('click', function() { closeModal('#updateAreaModal'); });

            // Open Modal
            $(document).on('click', '.btn-toggle-status', function() {
                var id = $(this).data('id');
                $('#toggle-service-id').val(id);
                openModal('#toggleStatusModal');
            });

            // Open Update Modal
            $(document).on('click', '.btn-edit-area', function() {
                var id = $(this).data('id');
                var name = $(this).data('name');
                var fee = $(this).data('fee');
                
                $('#update-area-id').val(id);
                $('#update-area-name').val(name);
                $('#update-area-fee').val(fee);
                
                openModal('#updateAreaModal');
            });

            // Confirm Toggle
            $('#btn-confirm-toggle').on('click', function() {
                var id = $('#toggle-service-id').val();
                var $btn = $(this);
                var originalHtml = $btn.html();
                
                $btn.prop('disabled', true).html('<i data-lucide="loader" style="width: 1rem; height: 1rem; animation: spin 1s linear infinite;"></i>');
                if (typeof lucide !== 'undefined') lucide.createIcons();

                $.ajax({
                    url: '/area/toggle-area/' + id,
                    type: 'POST',
                    success: function(res) {
                        if(res.success) {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.success(res.message || 'Status updated.');
                            }
                            closeModal('#toggleStatusModal');
                            // Reload page after a short delay
                            setTimeout(function() { window.location.reload(); }, 1000);
                        }
                        else {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.error(res.message || 'Error updating status.');
                            } else {
                                alert(res.message || 'Error updating status');
                            }
                            $btn.prop('disabled', false).html(originalHtml);
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                        }
                    },
                    error: function() {
                        if (typeof window.AppToast !== 'undefined') {
                            window.AppToast.error('Server error.');
                        } else {
                            alert('Server error');
                        }
                        $btn.prop('disabled', false).html(originalHtml);
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }
                });
            });

            // Submit Update Form
            $('#form-update-area').on('submit', function(e) {
                e.preventDefault();
                
                var $btn = $('#btn-submit-update');
                var originalHtml = $btn.html();
                $btn.prop('disabled', true).html('<i data-lucide="loader" style="width: 1rem; height: 1rem; animation: spin 1s linear infinite;"></i> Saving...');
                if (typeof lucide !== 'undefined') lucide.createIcons();

                var payload = {
                    AreaID: parseInt($('#update-area-id').val()),
                    Name: $('#update-area-name').val(),
                    BaseFee: parseFloat($('#update-area-fee').val())
                };

                $.ajax({
                    url: '/area/update-area',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if(res.success) {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.success(res.message || 'Area updated successfully.');
                            }
                            closeModal('#updateAreaModal');
                            setTimeout(function() { window.location.reload(); }, 1000);
                        } else {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.error(res.message || 'Error updating area.');
                            } else {
                                alert(res.message || 'Error updating area.');
                            }
                            $btn.prop('disabled', false).html(originalHtml);
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                        }
                    },
                    error: function() {
                        if (typeof window.AppToast !== 'undefined') {
                            window.AppToast.error('Server error.');
                        } else {
                            alert('Server error.');
                        }
                        $btn.prop('disabled', false).html(originalHtml);
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }
                });
            });
            
            $("<style type='text/css'>@@keyframes spin { 100% { transform: rotate(360deg); } } </style>").appendTo("head");
        });
    </script>
}
