@using MakeUpServiceAdmin.ViewModel.AreaVm
@model CreateAreaVm
@{
    ViewData["Title"] = "Create Area";
}

<style>
    .create-page-wrapper {
        max-width: 42rem;
        margin: 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }
    
    .create-header {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .create-header h2 {
        font-size: 1.875rem;
        color: var(--color-on-background);
        margin: 0;
        line-height: 1.2;
    }
    .create-header p {
        font-size: 0.875rem;
        color: var(--color-on-surface-variant);
        margin: 0;
    }

    .create-form-container {
        padding: 1.5rem;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(212, 196, 183, 0.5);
    }

    .create-form {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .form-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--color-on-surface-variant);
    }

    .form-footer {
        padding-top: 1rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        border-top: 1px solid var(--color-surface-container-highest);
    }
</style>

<div class="create-page-wrapper">
    <div class="create-header">
        <h2>Add Service Area</h2>
        <p>Define a new coverage zone and travel fee.</p>
    </div>

    <div class="glass-card create-form-container">
        <form id="standalone-create-area" class="create-form">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label class="form-label">Area Name</label>
                <input type="text" name="Name" class="input-glow create-area-name" placeholder="e.g. Downtown Metro" required />
            </div>
            <div class="form-group">
                <label class="form-label">Travel Fee (RM)</label>
                <input type="number" name="Fee" class="input-glow create-area-fee" min="0" step="0.01" placeholder="50.00" required>
            </div>

            <div class="form-footer">
                <a href="@Url.Action("GetAreas", "Area")" class="btn-ghost">Cancel</a>
                <button type="submit" class="btn-primary" id="btn-save">Add Area</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#standalone-create-area').on('submit', function(e) {
                e.preventDefault();
                
                var $btn = $('#btn-save');
                var originalText = $btn.html();
                $btn.prop('disabled', true).html('<i data-lucide="loader" style="width: 1rem; height: 1rem; animation: spin 1s linear infinite;"></i> Saving...');
                if (typeof lucide !== 'undefined') lucide.createIcons();

                var name = $('.create-area-name').val();
                var fee = $('.create-area-fee').val();
                var formData = {
                    Name: name,
                    Price: parseFloat(fee)
                };
                
                var idempotencyKey = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                    var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
                    return v.toString(16);
                });
                
                $.ajax({
                    url: '/area/create-area',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    headers: {
                        'X-Idempotency-Key': idempotencyKey
                    },
                    success: function(response) {
                        if (response.success) {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.success(response.message || 'Area created successfully.');
                            } else {
                                alert(response.message);
                            }
                            setTimeout(function() {
                                window.location.href = '/area/areas'; // Redirect to the areas list page
                            }, 1000);
                        }
                        else {
                            if (typeof window.AppToast !== 'undefined') {
                                window.AppToast.error(response.message || 'Error creating area.');
                            } else {
                                alert(response.message);
                            }
                            $btn.prop('disabled', false).html(originalText);
                            if (typeof lucide !== 'undefined') lucide.createIcons();
                        }
                    },
                    error: function(xhr, status, error) {
                        if (typeof window.AppToast !== 'undefined') {
                            window.AppToast.error('An error occurred while creating the area. Please try again.');
                        } else {
                            alert('An error occurred while creating the area. Please try again.');
                        }
                        $btn.prop('disabled', false).html(originalText);
                        if (typeof lucide !== 'undefined') lucide.createIcons();
                    }
                });
            });
            
            $("<style type='text/css'>@@keyframes spin { 100% { transform: rotate(360deg); } } </style>").appendTo("head");
        });
    </script>
}
