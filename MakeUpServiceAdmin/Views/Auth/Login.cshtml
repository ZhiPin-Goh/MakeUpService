@{
    ViewData["Title"] = "Login - Admin Portal";
    Layout = null; // No navbar/sidebar for login
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shirley Makeup</title>
    <!-- Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- Tailwind v4 CDN -->
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237d562d' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08'/%3E%3Cpath d='M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z'/%3E%3C/svg%3E">

    <style type="text/tailwindcss">
        @@theme {
          --color-background: #fbf9f8;
          --color-on-background: #1b1c1c;
          --color-surface: #ffffff;
          --color-surface-dim: #dbd9d9;
          --color-surface-bright: #fbf9f8;
          --color-surface-container-lowest: #ffffff;
          --color-surface-container-low: #f5f3f3;
          --color-surface-container: #efeded;
          --color-surface-container-high: #eae8e7;
          --color-surface-container-highest: #e4e2e2;
          --color-on-surface: #1b1c1c;
          --color-on-surface-variant: #50453b;
          --color-inverse-surface: #303030;
          --color-inverse-on-surface: #f2f0f0;
          --color-outline: #82756a;
          --color-outline-variant: #d4c4b7;
          --color-primary: #7d562d;
          --color-on-primary: #ffffff;
          --color-primary-container: #d4a373;
          --color-on-primary-container: #5b3912;
          --color-inverse-primary: #f0bd8b;
          --color-secondary: #645e4b;
          --color-on-secondary: #ffffff;
          --color-secondary-container: #ece2c9;
          --color-on-secondary-container: #6b6450;
          --color-tertiary: #6a5d43;
          --color-on-tertiary: #ffffff;
          --color-tertiary-container: #bbab8d;
          --color-on-tertiary-container: #4b3f28;
          --color-error: #ba1a1a;
          --color-on-error: #ffffff;
          --color-error-container: #ffdad6;
          --color-on-error-container: #93000a;
          --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
          --font-display: "Playfair Display", ui-serif, Georgia, serif;
        }
        body {
            @@apply bg-background text-on-background font-sans antialiased selection:bg-primary-container/30 selection:text-primary;
        }
        h1, h2, h3, h4, h5, h6 {
            @@apply font-display tracking-tight text-on-surface;
        }
        .glass-card {
            @@apply bg-surface/90 backdrop-blur-md border border-surface-container-highest rounded-xl shadow-[0_4px_24px_rgba(0,0,0,0.04)];
        }
        .input-glow {
            @@apply bg-surface border border-outline-variant rounded-lg px-4 py-2 text-sm text-on-surface placeholder-on-surface-variant/50 transition-all;
        }
        .input-glow:focus {
            @@apply border-primary-container outline-none;
            box-shadow: 0 0 0 3px rgba(212, 163, 115, 0.15);
        }
        .btn-primary {
            @@apply bg-primary-container text-white font-semibold text-sm px-4 py-2 rounded-lg hover:bg-primary transition-colors flex items-center justify-center gap-2 shadow-sm hover:shadow active:scale-[0.98] duration-150;
        }
    </style>
</head>
<body>
    <div class="min-h-screen bg-background flex flex-col justify-center items-center p-6 selection:bg-primary-container/20 selection:text-primary relative overflow-hidden">
      
      <!-- Decorative background elements -->
      <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-primary/10 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-secondary/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="w-full max-w-[420px] relative z-10">
        <!-- Brand Header -->
        <div class="flex flex-col items-center text-center mb-10">
          <div class="w-16 h-16 rounded-full bg-surface border border-outline-variant flex items-center justify-center mb-6 shadow-md shadow-primary/5">
            <i data-lucide="brush" class="w-8 h-8 text-primary" style="stroke-width:1.5;"></i>
          </div>
          <h1 class="text-3xl font-display font-bold text-on-background tracking-tight mb-2">Shirley Makeup</h1>
          <p class="text-sm font-medium text-on-surface-variant uppercase tracking-widest">Admin Portal</p>
        </div>

        <!-- Login Card -->
        <div class="glass-card p-8 sm:p-10 shadow-xl shadow-black/5 border border-outline-variant/50">
          <div class="mb-8">
            <h2 class="text-xl font-bold text-on-surface mb-2">Welcome back</h2>
            <p class="text-sm text-on-surface-variant">Sign in to manage your bookings, clients, and studio analytics.</p>
          </div>

          <form id="login-form" class="space-y-5">
            @Html.AntiForgeryToken()
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant">Username</label>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                  <i data-lucide="mail" class="w-4 h-4 text-on-surface-variant/50"></i>
                </div>
                <input type="text" id="UserName" required class="input-glow w-full !pl-10 py-2.5 bg-surface text-sm placeholder:text-on-surface-variant/40" placeholder="admin" />
              </div>
            </div>

            <div class="space-y-1.5">
              <div class="flex justify-between items-center">
                <label class="block text-xs font-semibold uppercase tracking-wider text-on-surface-variant">Password</label>
              </div>
              <div class="relative">
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none">
                  <i data-lucide="lock" class="w-4 h-4 text-on-surface-variant/50"></i>
                </div>
                <input type="password" id="Password" required class="input-glow w-full !pl-10 !pr-10 py-2.5 bg-surface text-sm placeholder:text-on-surface-variant/40" placeholder="••••••••" />
              </div>
            </div>

            <div class="pt-2">
              <button type="submit" id="btn-login" class="btn-primary w-full py-3 flex items-center justify-center gap-2 group relative overflow-hidden">
                Sign In
                <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
              </button>
            </div>
          </form>
        </div>
        
        <div class="mt-8 text-center">
          <p class="text-xs text-on-surface-variant/60">
            Protected by enterprise-grade security. <br class="sm:hidden" />
            &copy; 2026 Shirley Makeup.
          </p>
        </div>
      </div>
    </div>
    
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/ui-alerts.js"></script>
    <script src="~/js/auth.js"></script>
    <script>
        lucide.createIcons();
        $(document).ready(function() {
            AuthManager.init({
                loginUrl: '@Url.Action("Login", "Auth")'
            });
        });
    </script>
</body>
</html>
