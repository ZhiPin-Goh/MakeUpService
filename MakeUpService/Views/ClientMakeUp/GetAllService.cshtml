@using HashidsNet
@model List<MakeUpService.Dto.ServiceDto.ServiceDto>
@{
    ViewData["Title"] = "Services";
    var hashids = new Hashids("ServiceIdSalt", 10);
}

<style>
    .services-page-container {
        padding: 4rem 1.5rem;
        max-width: 1440px;
        margin: 0 auto;
    }
    @@media (min-width: 768px) {
        .services-page-container { padding: 6rem 3rem; }
    }

    .services-page-header {
        text-align: center;
        margin-bottom: 4rem;
    }
    @@media (min-width: 768px) {
        .services-page-header { margin-bottom: 6rem; }
    }

    .services-page-title {
        font-family: var(--font-display);
        font-size: 2.5rem;
        color: var(--color-primary);
        margin-bottom: 1rem;
        line-height: 1.2;
    }
    @@media (min-width: 768px) {
        .services-page-title { font-size: 3.5rem; }
    }

    .services-page-subtitle {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        color: var(--color-secondary);
        max-width: 42rem;
        margin: 0 auto;
        line-height: 1.6;
    }

    .services-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 3rem;
    }
    @@media (min-width: 768px) {
        .services-grid { 
            grid-template-columns: repeat(2, 1fr);
            gap: 4rem 3rem;
        }
    }

    .service-item-card {
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        background-color: var(--color-surface);
        border-radius: 1.5rem;
        padding: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
        border: 1px solid rgba(212, 196, 183, 0.2);
        transition: transform 0.3s, box-shadow 0.3s;
    }
    .service-item-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
    }

    .service-image-container {
        position: relative;
        width: 100%;
        aspect-ratio: 3 / 2;
        border-radius: 1rem;
        overflow: hidden;
        background-color: var(--color-surface-container-high);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.5rem;
    }

    .service-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s ease;
    }
    .service-item-card:hover .service-image {
        transform: scale(1.05);
    }

    .service-image-placeholder {
        color: var(--color-secondary);
        font-family: var(--font-sans);
        font-size: 1rem;
    }

    .service-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
        opacity: 0;
        transition: opacity 0.5s;
    }
    .service-item-card:hover .service-overlay {
        opacity: 1;
    }

    .service-info-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .service-info-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        border-bottom: 1px solid rgba(212, 196, 183, 0.3);
        padding-bottom: 1rem;
    }

    .service-badge-pro {
        position: absolute;
        top: 1rem;
        left: 1rem;
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.375rem 0.75rem;
        background-color: rgba(255,255,255,0.9);
        backdrop-filter: blur(4px);
        color: var(--color-primary);
        font-family: var(--font-sans);
        font-size: 0.75rem;
        font-weight: 600;
        border-radius: 9999px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        z-index: 10;
    }

    .service-name {
        font-family: var(--font-display);
        font-size: 1.5rem;
        color: var(--color-on-background);
        margin: 0;
        transition: color 0.3s;
    }
    .service-item-card:hover .service-name {
        color: var(--color-primary);
    }

    .service-price {
        font-family: var(--font-sans);
        font-size: 1.125rem;
        font-weight: 700;
        color: var(--color-primary);
        text-align: right;
        margin: 0;
    }

    .service-desc-text {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-secondary);
        margin: 0;
        line-height: 1.5;
    }

    .services-note-box {
        margin-top: 6rem;
        padding: 2rem;
        background-color: var(--color-surface-container-low);
        border-radius: 1rem;
        border: 1px solid rgba(212, 196, 183, 0.2);
        text-align: center;
        max-width: 48rem;
        margin-left: auto;
        margin-right: auto;
    }

    .services-note-icon {
        color: var(--color-primary);
        margin-bottom: 0.5rem;
        width: 1.5rem;
        height: 1.5rem;
        display: inline-block;
    }

    .services-note-text {
        font-family: var(--font-sans);
        font-size: 0.875rem;
        color: var(--color-secondary);
        font-style: italic;
        margin: 0;
        line-height: 1.5;
    }
</style>

<div class="services-page-container">
    <div data-aos="fade-up" class="services-page-header">
        <h1 class="services-page-title">Curated Services</h1>
        <p class="services-page-subtitle">Tailored makeup artistry for your most memorable moments. Editorial quality, refined for every occasion.</p>
    </div>

    <div class="services-grid">
        @{
            int idx = 0;
            foreach (var service in Model)
            {
                var hashid = hashids.Encode(service.ServiceID);
                int delay = (idx % 2 == 0) ? 0 : 200;
                <a href="/services/@hashid" data-aos="fade-up" data-aos-delay="@delay" class="service-item-card">
                    <div class="service-image-container">
                        <div class="service-badge-pro">
                            <i data-lucide="sparkles" class="w-3 h-3"></i>
                            <span>Professional</span>
                        </div>
                        @if (!string.IsNullOrEmpty(service.ImageUrl))
                        {
                            <img alt="@service.Name" class="service-image" src="@service.ImageUrl" />
                        }
                        else
                        {
                            <span class="service-image-placeholder">No image available</span>
                        }
                        <div class="service-overlay"></div>
                    </div>
                    <div class="service-info-container">
                        <div class="service-info-top">
                            <h2 class="service-name">@service.Name</h2>
                            <p class="service-price">RM @service.Price</p>
                        </div>
                        <p class="service-desc-text"><span>Discover our premium</span> @service.Name <span>service tailored for you.</span></p>
                    </div>
                </a>
                idx++;
            }
        }
    </div>

    <div class="services-note-box">
        <i data-lucide="info" class="services-note-icon"></i>
        <p class="services-note-text">Note: Final price may include travel fees based on location distance. All services require a non-refundable deposit to secure the booking date.</p>
    </div>
</div>
