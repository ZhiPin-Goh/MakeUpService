@model ErrorViewModel
@{
    ViewData["Title"] = "System Error";
}

<div class="min-h-[70vh] flex items-center justify-center px-6 py-12 md:py-20 bg-background text-on-background">
    <div class="text-center max-w-2xl mx-auto flex flex-col items-center">
        <!-- Graphic / Icon -->
        <div class="w-24 h-24 rounded-full bg-error-container text-on-error-container flex items-center justify-center mb-8 shadow-sm">
            <i data-lucide="server-crash" style="width: 3rem; height: 3rem;"></i>
        </div>
        
        <h1 class="font-display text-4xl md:text-5xl text-error mb-4 font-bold tracking-wide">
            Connection Lost
        </h1>
        <h2 class="font-sans text-xl md:text-2xl text-on-background mb-4 font-semibold">
            We are experiencing technical difficulties.
        </h2>
        
        <p class="font-sans text-base text-on-surface-variant leading-relaxed mb-10 max-w-lg">
            We're having trouble connecting to our booking system right now. Our team has been notified and is working to restore service immediately. Please try again in a few moments.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto mb-8">
            <button onclick="window.location.reload()" class="w-full sm:w-auto bg-primary text-white px-8 py-3.5 rounded-full font-sans text-sm font-semibold tracking-widest uppercase flex items-center justify-center gap-2 shadow-md hover:bg-transparent hover:text-primary border border-primary transition-all duration-300 cursor-pointer">
                <i data-lucide="refresh-cw" style="width: 1rem; height: 1rem;"></i>
                <span>Try Again</span>
            </button>
            <a href="/" class="w-full sm:w-auto bg-transparent text-primary border border-primary px-8 py-3.5 rounded-full font-sans text-sm font-semibold tracking-widest uppercase flex items-center justify-center gap-2 transition-all duration-300 hover:bg-primary hover:text-white">
                <i data-lucide="home" style="width: 1rem; height: 1rem;"></i>
                <span>Return Home</span>
            </a>
        </div>

        @if (Model != null && Model.ShowRequestId)
        {
            <div class="bg-surface-container p-4 rounded-xl text-sm font-sans text-on-surface-variant border border-outline-variant/30">
                <p class="mb-1 text-xs uppercase tracking-wider font-semibold">Reference ID</p>
                <code class="text-primary font-mono bg-surface-container-high px-2 py-1 rounded">@Model.RequestId</code>
            </div>
        }
    </div>
</div>
