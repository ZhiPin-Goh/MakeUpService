    <!-- Lenis Smooth Scrolling (Momentum Scroll) -->
    <script src="https://cdn.jsdelivr.net/gh/studio-freight/lenis@1.0.29/bundled/lenis.min.js"></script>
    <script>
        const lenis = new Lenis({
            duration: 1.2,
            easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
            direction: 'vertical',
            gestureDirection: 'vertical',
            smooth: true,
            mouseMultiplier: 1,
            smoothTouch: false,
            touchMultiplier: 2,
            infinite: false,
        })

        function raf(time) {
            lenis.raf(time)
            requestAnimationFrame(raf)
        }

        requestAnimationFrame(raf)
    </script>

    <script>
        lucide.createIcons();
        
        // Global object to store translations loaded from JSON (EN -> CN mapping)
        var currentTranslations = {};

        function applyTranslation(lang) {
            if (lang === 'CN') {
                $('*').contents().filter(function() {
                    return this.nodeType === 3 && this.nodeValue.trim() !== '';
                }).each(function() {
                    var originalText = this.nodeValue.trim();
                    if (currentTranslations[originalText]) {
                        if (!$(this.parentElement).attr('data-original-text')) {
                            $(this.parentElement).attr('data-original-text', originalText);
                        }
                        this.nodeValue = this.nodeValue.replace(originalText, currentTranslations[originalText]);
                    }
                });
            } else {
                // Revert to English (using original text data attribute)
                $('[data-original-text]').each(function() {
                    $(this).contents().filter(function() {
                        return this.nodeType === 3 && this.nodeValue.trim() !== '';
                    }).each(function() {
                        var currentText = this.nodeValue.trim();
                        // Find the reverse mapping (CN -> EN) using our loaded dictionary
                        for (var key in currentTranslations) {
                            if (currentTranslations[key] === currentText) {
                                this.nodeValue = this.nodeValue.replace(currentText, key);
                                break;
                            }
                        }
                    });
                });
            }
        }

        async function loadAndApplyTranslation(lang) {
            try {
                // We only need the Chinese dictionary for both translating and reverting
                if (Object.keys(currentTranslations).length === 0) {
                    const response = await fetch('/locales/zh.json');
                    if (response.ok) {
                        currentTranslations = await response.json();
                    } else {
                        console.error('Failed to load translations', response.statusText);
                        return;
                    }
                }
                applyTranslation(lang);
            } catch (error) {
                console.error('Error loading translation file:', error);
            }
        }

        $(document).ready(function() {
            var currentLang = localStorage.getItem('site_lang') || 'EN';
            $('.lang-text').text(currentLang);
            
            // Load and apply immediately on load if CN
            if (currentLang === 'CN') {
                loadAndApplyTranslation('CN');
            }

            $('.lang-toggle-btn').on('click', function(e) {
                e.preventDefault();
                var newLang = currentLang === 'EN' ? 'CN' : 'EN';
                currentLang = newLang; // Update global state early
                
                $('.lang-text').text(currentLang);
                localStorage.setItem('site_lang', currentLang);
                
                loadAndApplyTranslation(currentLang);
            });

            // Mobile Menu Toggle Logic
            $('#mobile-menu-open').on('click', function() {
                $('#mobile-menu').removeClass('opacity-0 pointer-events-none').addClass('opacity-100 pointer-events-auto');
                $('body').css('overflow', 'hidden'); // Prevent background scrolling
            });
            
            $('#mobile-menu-close, .mobile-nav-link').on('click', function() {
                $('#mobile-menu').removeClass('opacity-100 pointer-events-auto').addClass('opacity-0 pointer-events-none');
                $('body').css('overflow', ''); // Restore scrolling
            });
        });
    </script>
    
    <!-- Swiper JS -->
