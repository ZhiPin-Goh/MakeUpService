<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shirley Beauty</title>
    <!-- Tailwind v4 CDN -->
    <script src="https://unpkg.com/@@tailwindcss/browser@4"></script>
    <style type="text/tailwindcss">
        @@theme {
        --color-background: #fbf9f8;
        --color-on-background: #1b1c1c;
        --color-surface: #ffffff;
        --color-surface-dim: #dbd9d9;
        --color-surface-bright: #fbf9f8;
        --color-surface-container-lowest: #ffffff;
        --color-surface-container-low: #f5f3f3;
        --color-surface-container: #efeded;
        --color-surface-container-high: #eae8e7;
        --color-surface-container-highest: #e4e2e2;
        --color-on-surface: #1b1c1c;
        --color-on-surface-variant: #50453b;
        --color-inverse-surface: #303030;
        --color-inverse-on-surface: #f2f0f0;
        --color-outline: #82756a;
        --color-outline-variant: #d4c4b7;
        --color-primary: #7d562d;
        --color-on-primary: #ffffff;
        --color-primary-container: #d4a373;
        --color-on-primary-container: #5b3912;
        --color-inverse-primary: #f0bd8b;
        --color-secondary: #645e4b;
        --color-on-secondary: #ffffff;
        --color-secondary-container: #ece2c9;
        --color-on-secondary-container: #6b6450;
        --color-tertiary: #6a5d43;
        --color-on-tertiary: #ffffff;
        --color-tertiary-container: #bbab8d;
        --color-on-tertiary-container: #4b3f28;
        --color-error: #ba1a1a;
        --color-on-error: #ffffff;
        --color-error-container: #ffdad6;
        --color-on-error-container: #93000a;
        --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif;
        --font-display: "Playfair Display", ui-serif, Georgia, serif;
        }
    </style>
    
    <style>
        body {
            background-color: var(--color-background);
            color: var(--color-on-background);
        }

        /* Basic Resets to fix browser default link colors */
        a {
            color: inherit !important;
            text-decoration: inherit !important;
        }

        /* Global Color Utilities for Layout */
        .text-primary { color: var(--color-primary) !important; }
        .text-secondary { color: var(--color-secondary) !important; }
        .text-on-background { color: var(--color-on-background) !important; }
        .bg-primary-container { background-color: var(--color-primary-container) !important; }
        .text-on-tertiary { color: var(--color-on-tertiary) !important; }
        .text-on-surface-variant { color: var(--color-on-surface-variant) !important; }

        ::selection {
            background-color: var(--color-primary-container);
            color: var(--color-on-primary-container);
        }

        .glass-nav {
            -webkit-backdrop-filter: blur(16px);
            backdrop-filter: blur(16px);
            background: rgba(251, 249, 248, 0.9);
            border-bottom: 1px solid rgba(125, 86, 45, 0.15);
        }
        
        .nav-link-hover {
            position: relative;
        }
        .nav-link-hover::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: -4px;
            left: 0;
            background-color: var(--color-primary);
            transition: width 0.3s ease;
        }
        .nav-link-hover:hover::after {
            width: 100%;
        }

        /* Footer Styles */
        .site-footer {
            width: 100%;
            margin-top: 6rem;
            background-color: var(--color-surface-container-lowest);
            border-top: 1.5px solid rgba(212, 196, 183, 0.2);
            padding-top: 4rem;
            padding-bottom: 3rem;
        }
        @@media (prefers-color-scheme: dark) {
            .site-footer { background-color: var(--color-surface-container-high); }
        }
        .footer-container {
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 1.5rem;
        }
        @@media (min-width: 768px) {
            .footer-container { padding: 0 3rem; }
        }
        .footer-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 2.5rem;
            margin-bottom: 3rem;
        }
        @@media (min-width: 768px) { .footer-grid { grid-template-columns: repeat(12, 1fr); } }
        @@media (min-width: 1024px) { .footer-grid { gap: 3rem; } }
        
        .footer-col-brand {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        @@media (min-width: 768px) { .footer-col-brand { grid-column: span 5 / span 5; } }
        .footer-brand-title {
            display: inline-block;
            font-family: var(--font-display);
            font-size: 1.25rem;
            letter-spacing: -0.05em;
            color: var(--color-primary);
            text-transform: uppercase;
            margin-bottom: 1rem;
            text-decoration: none;
        }
        .footer-brand-desc {
            font-family: var(--font-sans);
            font-size: 0.875rem;
            color: var(--color-on-surface-variant);
            max-width: 24rem;
            margin-bottom: 1.25rem;
            line-height: 1.625;
        }
        @@media (min-width: 768px) { .footer-brand-desc { font-size: 1rem; } }
        .footer-location {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.75rem;
            color: rgba(80, 69, 59, 0.8);
            margin-bottom: 1.5rem;
        }
        .footer-socials {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .social-icon-btn {
            width: 2.5rem;
            height: 2.5rem;
            border-radius: 9999px;
            background-color: rgba(239, 237, 237, 0.6);
            color: var(--color-on-surface-variant);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.3s;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }
        .social-icon-btn:hover { background-color: var(--color-primary-container); color: white; }
        .social-icon-btn.whatsapp:hover { background-color: #059669; }

        .footer-col-explore {}
        @@media (min-width: 768px) { .footer-col-explore { grid-column: span 3 / span 3; } }
        .footer-col-title {
            font-family: var(--font-sans);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: var(--color-primary);
            font-weight: 700;
            margin-bottom: 1.25rem;
        }
        .footer-links-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 0.75rem;
            font-family: var(--font-sans);
            font-size: 0.875rem;
            color: var(--color-on-surface-variant);
        }
        .footer-link { transition: color 0.3s; text-decoration: none; color: inherit; }
        .footer-link:hover { color: var(--color-primary); }

        .footer-col-booking {
            background-color: rgba(239, 237, 237, 0.3);
            border: 1px solid rgba(212, 196, 183, 0.15);
            padding: 1.5rem;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        @@media (min-width: 768px) { .footer-col-booking { grid-column: span 4 / span 4; } }
        .studio-hours-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.375rem;
            color: var(--color-secondary);
            font-family: var(--font-sans);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.5rem;
            font-weight: 600;
        }
        .studio-hours-title { font-family: var(--font-display); font-size: 1rem; color: var(--color-primary); margin-bottom: 0.5rem; }
        .studio-hours-desc { font-family: var(--font-sans); font-size: 0.75rem; color: rgba(80, 69, 59, 0.8); margin-bottom: 1.25rem; line-height: 1.625; }
        .btn-reserve {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            background-color: var(--color-primary-container);
            color: white;
            padding: 0.75rem 0;
            border-radius: 0.75rem;
            font-family: var(--font-sans);
            font-size: 0.75rem;
            transition: all 0.3s;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
            text-decoration: none;
        }
        .btn-reserve:hover { background-color: var(--color-primary); color: white; }
        
        .footer-bottom {
            padding-top: 2rem;
            border-top: 1px solid rgba(212, 196, 183, 0.2);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            font-size: 0.75rem;
            color: rgba(80, 69, 59, 0.7);
            font-family: var(--font-sans);
        }
        @@media (min-width: 640px) { .footer-bottom { flex-direction: row; } }
        .footer-bottom-links {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: center;
            gap: 0.5rem 1.5rem;
        }

        .floating-chatbot {
            position: fixed;
            bottom: 5rem;
            right: 4rem;
            z-index: 50;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .chatbot-btn {
            background-color: var(--color-primary);
            color: var(--color-on-primary);
            border-radius: 9999px;
            height: 3.5rem;
            width: 3.5rem;
            box-shadow: 0 10px 20px -5px rgba(212, 175, 55, 0.1);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s;
            cursor: pointer;
        }
        .chatbot-btn:hover { transform: scale(1.1); }
        .chatbot-btn:active { transform: scale(0.9); }
        .chatbot-tooltip {
            position: absolute;
            right: 100%;
            margin-right: 1rem;
            background-color: var(--color-surface);
            padding: 0.75rem;
            border-radius: 0.5rem;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s;
            width: 12rem;
            text-align: left;
        }
        .floating-chatbot:hover .chatbot-tooltip { opacity: 1; }
        .chatbot-tooltip-title { font-family: var(--font-sans); font-size: 0.875rem; color: var(--color-primary); margin-bottom: 0.25rem; font-weight: 600; }
        .chatbot-tooltip-desc { font-size: 0.75rem; color: var(--color-on-surface-variant); }


        .float-card {
            box-shadow: 0 4px 20px rgba(95, 94, 94, 0.04);
        }

        .shadow-20px-blur {
            box-shadow: 0 10px 20px -5px rgba(212, 175, 55, 0.1), 0 8px 10px -6px rgba(212, 175, 55, 0.1);
        }

        .masonry-grid {
            column-count: 1;
            column-gap: 24px;
        }

        @@media (min-width: 768px) {
            .masonry-grid {
                column-count: 2;
            }
        }

        @@media (min-width: 1024px) {
            .masonry-grid {
                column-count: 3;
            }
        }

        .masonry-item {
            break-inside: avoid;
            margin-bottom: 24px;
        }

        .slider-handle {
            cursor: ew-resize;
            z-index: 20;
            background-color: #fff;
            width: 2px;
            position: absolute;
            top: 0;
            bottom: 0;
        }

        .slider-handle:after {
            content: "< >";
            color: #d4af37;
            background-color: #fff;
            border-radius: 50%;
            justify-content: center;
            align-items: center;
            width: 40px;
            height: 40px;
            font-size: 14px;
            font-weight: 700;
            display: flex;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }

        .slider-overlay {
            z-index: 10;
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            overflow: hidden;
        }
    </style>
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%237d562d' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='m9.06 11.9 8.07-8.06a2.85 2.85 0 1 1 4.03 4.03l-8.06 8.08'/%3E%3Cpath d='M7.07 14.94c-1.66 0-3 1.35-3 3.02 0 1.33-2.5 1.52-2 2.02 1.08 1.1 2.49 2.02 4 2.02 2.2 0 4-1.8 4-4.04a3.01 3.01 0 0 0-3-3.02z'/%3E%3C/svg%3E">
    <link rel="stylesheet" href="~/MakeUpService.styles.css" asp-append-version="true" />
    
    <!-- Swiper CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <!-- AOS Animation CSS -->
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-background text-on-background antialiased font-body-md overflow-x-hidden">
    
    @{
        bool isChat = Context.Request.Path.StartsWithSegments("/chat", StringComparison.OrdinalIgnoreCase);
        string layoutClasses = isChat ? "h-screen overflow-y-hidden" : "";
        string mainClasses = isChat ? "flex flex-col h-full overflow-hidden" : "";
    }

    <div class="flex flex-col min-h-screen pt-24 @layoutClasses">
        <header class="fixed top-0 w-full z-50 glass-nav transition-all duration-300" style="padding-top: 0.5rem; padding-bottom: 0.5rem;">
            <div class="flex justify-between items-center px-margin-mobile md:px-margin-desktop py-4 max-w-container-max mx-auto" style="margin-inline: 50px">
                <a href="/" class="font-display text-2xl tracking-[0.2em] uppercase hover:opacity-80 transition-all duration-300 font-bold text-decoration-none" style="color: var(--color-primary);">
                    SHIRLEY
                </a>
                <nav class="hidden md:flex space-x-10 items-center font-sans text-xs uppercase tracking-widest font-semibold">
                    <a href="/" class="nav-link-hover text-secondary hover:text-primary transition-colors duration-300 text-decoration-none">Home</a>
                    <a href="/services/my-services" class="nav-link-hover text-secondary hover:text-primary transition-colors duration-300 text-decoration-none">Services</a>
                    <a href="/about" class="nav-link-hover text-secondary hover:text-primary transition-colors duration-300 text-decoration-none">About</a>
                    <a href="/faq" class="nav-link-hover text-secondary hover:text-primary transition-colors duration-300 text-decoration-none">FAQ</a>
                    <a href="/feedback" class="nav-link-hover text-secondary hover:text-primary transition-colors duration-300 text-decoration-none">Feedback</a>
                </nav>
                <div class="hidden md:flex items-center space-x-6">
                    <button class="lang-toggle-btn flex items-center space-x-1.5 text-secondary hover:text-primary transition-colors" title="Toggle Language">
                        <i data-lucide="globe" class="w-4 h-4"></i>
                        <span class="lang-text font-sans text-xs uppercase font-bold tracking-widest">EN</span>
                    </button>
                    <a href="/booking" style="border-radius:15px" class="flex items-center justify-center bg-primary text-white px-7 py-2.5 border border-primary font-sans text-xs uppercase tracking-[0.15em] hover:bg-transparent hover:text-primary transition-all duration-300 text-decoration-none">
                        Book Now
                    </a>
                </div>
                <div class="md:hidden flex items-center space-x-4">
                    <button class="lang-toggle-btn flex items-center space-x-1 text-primary hover:opacity-80 transition-opacity">
                        <i data-lucide="globe" class="w-4 h-4"></i>
                        <span class="lang-text font-sans text-xs font-bold uppercase tracking-widest">EN</span>
                    </button>
                    <button id="mobile-menu-open" class="text-primary focus:outline-none p-1 hover:opacity-80">
                        <i data-lucide="menu" class="w-6 h-6"></i>
                    </button>
                </div>
            </div>
        </header>

        <!-- Mobile Menu Overlay -->
        <div id="mobile-menu" class="fixed inset-0 z-[60] bg-surface-bright/98 backdrop-blur-xl flex flex-col justify-center items-center opacity-0 pointer-events-none transition-all duration-300">
            <button id="mobile-menu-close" class="absolute top-8 right-6 text-primary p-2 hover:opacity-70 transition-opacity">
                <i data-lucide="x" class="w-8 h-8"></i>
            </button>
            <nav class="flex flex-col items-center space-y-8 font-display text-2xl uppercase tracking-[0.15em] font-semibold">
                <a href="/" class="mobile-nav-link text-primary hover:text-primary-container transition-colors text-decoration-none">Home</a>
                <a href="/services/my-services" class="mobile-nav-link text-primary hover:text-primary-container transition-colors text-decoration-none">Services</a>
                <a href="/about" class="mobile-nav-link text-primary hover:text-primary-container transition-colors text-decoration-none">About</a>
                <a href="/faq" class="mobile-nav-link text-primary hover:text-primary-container transition-colors text-decoration-none">FAQ</a>
                <a href="/feedback" class="mobile-nav-link text-primary hover:text-primary-container transition-colors text-decoration-none">Feedback</a>
                
                <a href="/booking" style="border-radius: 15px" class="mobile-nav-link mt-8 bg-primary text-white px-10 py-4 border border-primary font-sans text-sm uppercase tracking-widest hover:bg-transparent hover:text-primary transition-all duration-300 text-decoration-none">
                    Book Now
                </a>
            </nav>
        </div>

        <main class="flex-grow w-full @mainClasses">
            @RenderBody()
        </main>

        @if (!isChat)
        {
            <footer class="site-footer">
                <div class="footer-container">
                    <div class="footer-grid">
                        <div class="footer-col-brand">
                            <div>
                                <a href="/" class="footer-brand-title">
                                    SHIRLEY MAKE UP
                                </a>
                                <p class="footer-brand-desc">
                                    Elevating natural beauty through refined, editorial-inspired artistry.
                                </p>
                                <div class="footer-location">
                                    <i data-lucide="map-pin" style="width: 1rem; height: 1rem; color: var(--color-primary);"></i>
                                    <span>Klang Valley, Malaysia & Destination Weddings Worldwide</span>
                                </div>
                            </div>
                            <div class="footer-socials">
