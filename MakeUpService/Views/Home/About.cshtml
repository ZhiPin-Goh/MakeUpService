@{
    ViewData["Title"] = "About Shirley";
}

<style type="text/css">
    .about-page-container {
        padding-left: 1.5rem;
        padding-right: 1.5rem;
        padding-top: 4rem;
        padding-bottom: 4rem;
    }
    @@media (min-width: 768px) {
        .about-page-container {
            padding-left: 3rem;
            padding-right: 3rem;
            padding-top: 6rem;
        }
    }
    
    .about-section {
        margin-bottom: 4rem;
    }
    
    .about-header {
        text-align: center;
        margin-bottom: 3rem;
    }
    
    .about-title {
        font-family: var(--font-headline);
        font-size: 2rem;
        color: var(--color-on-background);
        margin-bottom: 1rem;
    }
    @@media (min-width: 768px) {
        .about-title {
            font-size: 3rem;
        }
    }
    
    .about-title-underline {
        width: 4rem;
        height: 0.125rem;
        background-color: var(--color-primary-container);
        margin: 0 auto;
    }
    
    .about-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.5rem;
        grid-auto-rows: minmax(250px, auto);
    }
    @@media (min-width: 768px) {
        .about-grid {
            grid-template-columns: repeat(12, 1fr);
        }
    }
    
    .about-card-journey {
        background-color: var(--color-surface-container-lowest);
        border-radius: 0.75rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(95, 94, 94, 0.04);
    }
    @@media (min-width: 768px) {
        .about-card-journey {
            grid-column: span 8 / span 8;
            padding: 3rem;
        }
    }
    
    .about-blur-effect {
        position: absolute;
        top: 0;
        right: 0;
        width: 16rem;
        height: 16rem;
        background-color: rgba(212, 175, 55, 0.05);
        border-radius: 50%;
        filter: blur(24px);
        transform: translateY(-50%) translateX(25%);
        pointer-events: none;
    }
    
    .about-card-title {
        font-family: var(--font-headline);
        font-size: 1.5rem;
        color: var(--color-on-background);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    
    .about-card-text {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-on-surface-variant);
        max-width: 42rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        line-height: 1.6;
    }
    
    .about-card-philosophy {
        background-color: var(--color-surface-container-low);
        border-radius: 0.75rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        box-shadow: 0 4px 20px rgba(95, 94, 94, 0.04);
    }
    @@media (min-width: 768px) {
        .about-card-philosophy {
            grid-column: span 4 / span 4;
            padding: 2.5rem;
        }
    }
    
    .about-philosophy-icon {
        width: 2.5rem;
        height: 2.5rem;
        color: var(--color-primary-container);
        margin-bottom: 1.5rem;
        transition: transform 0.3s;
    }
    .about-card-philosophy:hover .about-philosophy-icon {
        transform: scale(1.1);
    }
    
    .about-quote {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-on-surface-variant);
        font-style: italic;
        border-left: 2px solid var(--color-primary-container);
        padding-left: 1rem;
        line-height: 1.6;
    }
    
    .about-card-qualifications {
        background-color: var(--color-surface-container-lowest);
        border-radius: 0.75rem;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        border: 1px solid rgba(212, 196, 183, 0.1);
        box-shadow: 0 4px 20px rgba(95, 94, 94, 0.04);
    }
    @@media (min-width: 768px) {
        .about-card-qualifications {
            grid-column: span 12 / span 12;
            padding: 3rem;
            flex-direction: row;
            align-items: flex-start;
        }
    }
    
    .about-qualifications-left {
        width: 100%;
        flex-shrink: 0;
    }
    @@media (min-width: 768px) {
        .about-qualifications-left {
            width: 33.333333%;
        }
    }
    
    .about-qualifications-desc {
        font-family: var(--font-sans);
        font-size: 1rem;
        color: var(--color-on-surface-variant);
        margin-bottom: 1.5rem;
        line-height: 1.6;
    }
    
    .btn-resume {
        padding: 0.5rem 1.5rem;
        border: 1px solid var(--color-primary-container);
        color: var(--color-primary-container);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: 9999px;
        background-color: transparent;
        transition: background-color 0.3s;
        cursor: pointer;
    }
    .btn-resume:hover {
        background-color: rgba(212, 175, 55, 0.05);
    }
    
    .about-qualifications-grid {
        width: 100%;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
    }
    @@media (min-width: 640px) {
        .about-qualifications-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (min-width: 768px) {
        .about-qualifications-grid {
            width: 66.666667%;
        }
    }
    
    .qualification-item {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }
    
    .qualification-icon {
        color: var(--color-primary-container);
        margin-top: 0.25rem;
        width: 1.5rem;
        height: 1.5rem;
        flex-shrink: 0;
    }
    
    .qualification-title {
        font-family: var(--font-sans);
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-on-background);
        margin-bottom: 0.5rem;
    }
    
    .qualification-text {
        font-family: var(--font-sans);
        font-size: 0.875rem;
        color: var(--color-on-surface-variant);
        line-height: 1.5;
    }
</style>

<div class="about-page-container">
    <section class="about-section">
        <div class="about-header">
            <h2 class="about-title">Behind the Brush</h2>
            <div class="about-title-underline"></div>
        </div>
        <div class="about-grid">
            <div class="about-card-journey">
                <div class="about-blur-effect"></div>
                <h3 class="about-card-title">
                    <i data-lucide="plane-takeoff" style="width: 2rem; height: 2rem; color: var(--color-primary-container);"></i>
                    Her Journey
                </h3>
                <div class="about-card-text">
                    <p>Starting over a decade ago in editorial fashion, my career has been a pursuit of perfect light and texture. I transitioned to high-end bridal makeup to bring that same meticulous runway standard to intimate, personal milestones.</p>
                    <p>Every face is a new canvas, and every journey I've taken—from studying fine arts to training under master cosmetologists—informs the delicate touch I bring to my clients today.</p>
                </div>
            </div>

            <div class="about-card-philosophy">
                <i data-lucide="leaf" class="about-philosophy-icon"></i>
                <h3 class="about-card-title">Philosophy on Beauty</h3>
                <p class="about-quote">
                    "Makeup should never act as a mask. It is a tool of revelation—a way to gently coax your innate confidence to the surface."
                </p>
            </div>

            <div class="about-card-qualifications">
                <div class="about-qualifications-left">
                    <h3 class="about-card-title">Professional Qualifications</h3>
                    <p class="about-qualifications-desc">A commitment to ongoing education and mastering the latest techniques in the industry.</p>
                    <button class="btn-resume">
                        View Full Resume
                    </button>
                </div>
                <div class="about-qualifications-grid">
                    <div class="qualification-item">
                        <i data-lucide="badge-check" class="qualification-icon"></i>
                        <div>
                            <h4 class="qualification-title">Master Cosmetologist License</h4>
                            <p class="qualification-text">Certified in advanced skin science and high-definition makeup application.</p>
                        </div>
                    </div>
                    <div class="qualification-item">
                        <i data-lucide="badge-check" class="qualification-icon"></i>
                        <div>
                            <h4 class="qualification-title">Editorial Certification</h4>
                            <p class="qualification-text">Specialized training in lighting-adaptable makeup for photography and film.</p>
                        </div>
                    </div>
                    <div class="qualification-item">
                        <i data-lucide="badge-check" class="qualification-icon"></i>
                        <div>
                            <h4 class="qualification-title">Bridal Masterclass</h4>
                            <p class="qualification-text">Completed exclusive workshops focusing on longevity and tear-proof techniques.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

