@section Scripts {
    <script>
        $(document).ready(function () {
            // Timeline Scrollytelling
            $(window).on('scroll', function() {
                var $timeline = $('.timeline-wrapper');
                if($timeline.length > 0) {
                    var timelineTop = $timeline.offset().top;
                    var timelineHeight = $timeline.outerHeight();
                    var windowHeight = $(window).height();
                    var scrollTop = $(window).scrollTop();
                    
                    // Progress starts when timeline is roughly 1/3 down the viewport
                    var triggerPoint = windowHeight * 0.65;
                    var scrollProgress = (scrollTop + triggerPoint - timelineTop) / timelineHeight;
                    
                    if (scrollProgress < 0) scrollProgress = 0;
                    if (scrollProgress > 1) scrollProgress = 1;
                    
                    $('#timeline-progress').css('height', (scrollProgress * 100) + '%');
                    
                    // Highlight nodes
                    $('.timeline-item').each(function() {
                        var itemTop = $(this).offset().top;
                        var $icon = $(this).find('.timeline-icon-node, .timeline-icon-node-highlight');
                        if (scrollTop + triggerPoint > itemTop) {
                            $icon.addClass('active');
                        } else {
                            $icon.removeClass('active');
                        }
                    });
                }
            });
            // Trigger scroll once on load to initialize state
            $(window).trigger('scroll');

            // Initialize Hero Swiper
            const heroSwiper = new Swiper('.hero-swiper', {
                loop: true,
                effect: 'fade', // provides a smooth crossfade if fade effect is included, otherwise regular slide
                speed: 1000,
                autoplay: {
                    delay: 5000,
                    disableOnInteraction: false,
                },
                pagination: {
                    el: '.swiper-pagination',
                    clickable: true,
                },
            });

            // Parallax Scroll for Hero Images & Horizontal Scroll for Services
            var $hSection = $('#horizontal-scroll-section');
            var $hContainer = $('#horizontal-scroll-container');
            var $heroImages = $('.hero-swiper img');

            // Use requestAnimationFrame for butter-smooth syncing with Lenis Momentum Scroll
            function renderScroll() {
                var scroll = window.scrollY;

                // 1. Hero Parallax
                if (scroll < window.innerHeight) {
                    $heroImages.css({
                        'transform': 'translateY(' + (scroll * 0.4) + 'px)'
                    });
                }

                // 2. Horizontal Scroll Section
                if ($hSection.length && $hContainer.length) {
                    var sectionTop = $hSection.offset().top;
                    var sectionHeight = $hSection.height();
                    var windowHeight = window.innerHeight;

                    var scrollableDistance = sectionHeight - windowHeight;

                    if (scrollableDistance > 0) {
                        var scrollProgress = (scroll - sectionTop) / scrollableDistance;
                        scrollProgress = Math.max(0, Math.min(1, scrollProgress));

                        // Calculate maximum translation distance
                        var containerWidth = $hContainer.get(0).scrollWidth;
                        var maxTranslate = containerWidth - window.innerWidth;

                        // Prevent transforming if content doesn't overflow
                        if (maxTranslate > 0) {
                            var translateX = -(scrollProgress * maxTranslate);

                            if (scroll >= sectionTop && scroll <= sectionTop + sectionHeight) {
                                 $hContainer.css('transform', 'translate3d(' + translateX + 'px, 0, 0)');
                            } else if (scroll < sectionTop) {
                                 $hContainer.css('transform', 'translate3d(0px, 0, 0)');
                            } else if (scroll > sectionTop + sectionHeight) {
                                 $hContainer.css('transform', 'translate3d(-' + maxTranslate + 'px, 0, 0)');
                            }
                        }
                    }
                }

                // 3. Portfolio Scroll-Pinned Gallery
                var $pSection = $('#portfolio-scroll-section');
                if ($pSection.length) {
                    var pTop = $pSection.offset().top;
                    var pHeight = $pSection.outerHeight();
                    var $cards = $pSection.find('.portfolio-card');
                    var $dots = $pSection.find('.portfolio-dot');
                    var totalCards = $cards.length;
                    
                    // Calculate which card should be active based on scroll position
                    var pProgress = (scroll - pTop) / (pHeight - windowHeight);
                    pProgress = Math.max(0, Math.min(1, pProgress));
                    
                    var activeIndex = Math.floor(pProgress * totalCards);
                    if (activeIndex >= totalCards) activeIndex = totalCards - 1;
                    
                    $cards.removeClass('active prev');
                    $dots.removeClass('active');
                    
                    $cards.eq(activeIndex).addClass('active');
                    $dots.eq(activeIndex).addClass('active');
                    
                    // Previous card stays slightly visible behind
                    if (activeIndex > 0) {
                        $cards.eq(activeIndex - 1).addClass('prev');
                    }
                }

                requestAnimationFrame(renderScroll);
            }

            // Start the render loop
            renderScroll();
        });
    </script>
}
