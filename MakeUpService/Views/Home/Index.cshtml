@using HashidsNet
@model MakeUpService.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    var hashids = new Hashids("ServiceIdSalt", 10);
}

<style>
    html {
        font-size: 14px;
        position: relative;
        min-height: 100%;
    }

    @@media (min-width: 768px) {
        html {
            font-size: 16px;
        }
    }

    body {
        margin-bottom: 0;
    }

    /* ============================================================
           Custom Style Overrides
           ============================================================ */
    .text-primary {
        color: var(--color-primary) !important;
    }

    .text-secondary {
        color: var(--color-secondary) !important;
    }

    .bg-primary {
        background-color: var(--color-primary) !important;
    }

    /* Remove default link underline */
    a {
        color: inherit;
        text-decoration: none;
    }

        a:hover {
            color: inherit;
            text-decoration: none;
        }

    /* ============================================================
       Home Page Semantic Classes
       ============================================================ */
    /* Hero Section */
    .hero-section { position: relative; width: 100%; height: 70vh; min-height: 500px; display: flex; align-items: center; justify-content: center; margin-top: -6rem; }
    .hero-overlay { position: absolute; inset: 0; z-index: 0; background: linear-gradient(to top, rgba(0,0,0,0.85), rgba(0,0,0,0.45), rgba(0,0,0,0.3)); pointer-events: none; }
    .scroll-indicator-btn { position: absolute; bottom: 2rem; left: 50%; transform: translateX(-50%); z-index: 20; color: rgba(255,255,255,0.8); display: flex; flex-direction: column; align-items: center; gap: 0.25rem; cursor: pointer; transition: color 0.3s; animation: bounce 1s infinite; border: none; background: transparent; }
    .scroll-indicator-btn:hover { color: white; }
    .scroll-indicator-text { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; font-family: var(--font-sans); font-weight: 500; color: rgba(255,255,255,0.7); }
    
    .banner-title-container { position: absolute; bottom: 4.5rem; left: 1.5rem; z-index: 10; pointer-events: none; max-width: 90%; }
    @@media (min-width: 768px) { .banner-title-container { bottom: 6rem; left: 4rem; max-width: 70%; } }
    .banner-title { color: white; font-family: var(--font-display); font-size: 2.5rem; font-weight: 600; letter-spacing: 0.05em; text-shadow: 0 4px 12px rgba(0,0,0,0.6); margin: 0; line-height: 1.2; text-align: left; }
    @@media (min-width: 768px) { .banner-title { font-size: 4rem; } }

    /* About Artist Section */
    .about-section { padding: 5rem 1rem; max-width: 1440px; margin: 0 auto; }
    @@media (min-width: 768px) { .about-section { padding: 7rem 2rem; } }
    .about-grid { display: grid; grid-template-columns: 1fr; gap: 3rem; align-items: center; }
    @@media (min-width: 1024px) { .about-grid { grid-template-columns: repeat(12, 1fr); gap: 4rem; } }
    .about-content { display: flex; flex-direction: column; justify-content: center; }
    @@media (min-width: 1024px) { .about-content { grid-column: span 7 / span 7; } }
    .section-header-tag { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-on-surface-variant); font-family: var(--font-sans); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
    .section-header-line { width: 2rem; height: 1px; background-color: var(--color-on-surface-variant); }
    .section-title { font-family: var(--font-display); font-size: 2rem; color: var(--color-on-background); margin-bottom: 1.5rem; line-height: 1.2; }
    @@media (min-width: 768px) { .section-title { font-size: 2.5rem; } }
    .about-desc { font-family: var(--font-sans); font-size: 1.125rem; color: var(--color-on-surface-variant); line-height: 1.625; margin-bottom: 2rem; }

    .feature-grid { display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2.5rem; }
    @@media (min-width: 640px) { .feature-grid { grid-template-columns: repeat(2, 1fr); } }
    .feature-card { display: flex; align-items: flex-start; gap: 1rem; padding: 1rem; border-radius: 0.75rem; background-color: var(--color-surface-container-lowest); border: 1px solid rgba(212, 196, 183, 0.2); box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
    .feature-icon-wrapper { width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background-color: rgba(212, 163, 115, 0.1); display: flex; align-items: center; justify-content: center; flex-shrink: 0; margin-top: 0.125rem; }
    .feature-icon { width: 1.25rem; height: 1.25rem; color: #d97706; }
    .feature-title { font-family: var(--font-sans); font-size: 0.875rem; color: var(--color-on-background); margin-bottom: 0.25rem; font-weight: 500; }
    .feature-desc { font-family: var(--font-sans); font-size: 0.75rem; color: var(--color-on-surface-variant); line-height: 1.5; margin: 0; }

    .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 0.75rem; background-color: var(--color-primary-container); color: white; font-family: var(--font-sans); font-size: 0.875rem; padding: 0.875rem 1.75rem; border-radius: 9999px; transition: all 0.3s; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); text-decoration: none; cursor: pointer; border: none; font-weight: 600; }
    .btn-primary:hover { background-color: var(--color-primary); }

    /* Process / Timeline Section */
    .process-section { padding: 5rem 1rem; background-color: var(--color-surface); position: relative; overflow: hidden; }
    @@media (min-width: 768px) { .process-section { padding: 7rem 2rem; } }
    .process-container { max-width: 56rem; margin: 0 auto; position: relative; }
    .process-header { text-align: center; margin-bottom: 4rem; }
    .timeline-line { position: absolute; left: 16px; top: 2rem; bottom: 2rem; width: 2px; background-color: rgba(212, 196, 183, 0.3); border-radius: 9999px; overflow: hidden; z-index: 0; }
    .timeline-line-progress { position: absolute; top: 0; left: 0; width: 100%; height: 0%; background-color: var(--color-primary); transition: height 0.1s ease-out; }
    @@media (min-width: 640px) { .timeline-line { left: 28px; } }
    @@media (min-width: 768px) { .timeline-line { left: 50%; transform: translateX(-50%); top: 0; bottom: 0; } }
    .timeline-wrapper { display: flex; flex-direction: column; gap: 3rem; position: relative; z-index: 10; padding-top: 2rem; padding-bottom: 2rem; }
    @@media (min-width: 768px) { .timeline-wrapper { gap: 6rem; padding-top: 0; padding-bottom: 0; } }
    .timeline-item { position: relative; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
    @@media (min-width: 768px) { .timeline-item { flex-direction: row; justify-content: space-between; align-items: flex-start; } }
    .timeline-icon-node { position: absolute; left: 0; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 9999px; background-color: var(--color-surface-container); border: 4px solid var(--color-surface); box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: all 0.4s ease; z-index: 10; }
    @@media (min-width: 640px) { .timeline-icon-node { width: 3.5rem; height: 3.5rem; } }
    @@media (min-width: 768px) { .timeline-icon-node { left: 50%; transform: translateX(-50%); } }
    .timeline-icon-node.active { background-color: var(--color-primary); border-color: rgba(255, 255, 255, 0.5); box-shadow: 0 0 15px rgba(189, 154, 115, 0.6); transform: scale(1.1); }
    @@media (min-width: 768px) { .timeline-icon-node.active { transform: translateX(-50%) scale(1.1); } }
    .timeline-icon-node.active i { color: #ffffff !important; transition: color 0.4s ease; }
    
    .timeline-icon-node-highlight { position: absolute; left: 0; display: flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 9999px; background-color: var(--color-primary); border: 4px solid var(--color-surface); box-shadow: 0 1px 2px rgba(0,0,0,0.05); transition: all 0.3s; z-index: 10; }
    @@media (min-width: 640px) { .timeline-icon-node-highlight { width: 3.5rem; height: 3.5rem; } }
    @@media (min-width: 768px) { .timeline-icon-node-highlight { left: 50%; transform: translateX(-50%); } }
    .timeline-item:hover .timeline-icon-node-highlight { transform: scale(1.1); }
    @@media (min-width: 768px) { .timeline-item:hover .timeline-icon-node-highlight { transform: translateX(-50%) scale(1.1); } }

    .timeline-content-left, .timeline-content-right { padding-left: 3.5rem; width: 100%; box-sizing: border-box; }
    @@media (min-width: 640px) { .timeline-content-left, .timeline-content-right { padding-left: 5rem; } }
    @@media (min-width: 768px) {
        .timeline-content-left { width: 41.666667%; padding-left: 0; padding-right: 3rem; text-align: right; }
        .timeline-content-right { width: 41.666667%; padding-left: 3rem; text-align: left; }
    }
    .timeline-spacer { display: none; }
    @@media (min-width: 768px) { .timeline-spacer { display: block; width: 41.666667%; } }
    
    .timeline-card { background-color: var(--color-surface-container-lowest); padding: 1.5rem; border-radius: 1rem; box-shadow: 0 1px 2px rgba(0,0,0,0.05); border: 1px solid rgba(212, 196, 183, 0.2); transition: box-shadow 0.3s; }
    .timeline-card:hover { box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); }
    .timeline-card-highlight { background-color: var(--color-primary-container); color: white; padding: 1.5rem; border-radius: 1rem; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); border: 1px solid rgba(125, 86, 45, 0.2); transition: box-shadow 0.3s; }
    .timeline-card-highlight:hover { box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1); }
    .timeline-step { font-family: var(--font-sans); font-size: 0.75rem; color: var(--color-primary); margin-bottom: 0.5rem; display: block; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; }
    .timeline-card-highlight .timeline-step { color: rgba(255,255,255,0.8); }
    .timeline-title { font-family: var(--font-sans); font-size: 1.125rem; color: var(--color-on-background); margin-bottom: 0.5rem; margin-top: 0; font-weight: 600; }
    .timeline-card-highlight .timeline-title { color: white; }
    .timeline-text { font-family: var(--font-sans); font-size: 0.875rem; color: var(--color-on-surface-variant); margin: 0; line-height: 1.5; }
    .timeline-card-highlight .timeline-text { color: rgba(255,255,255,0.9); }

    /* Services Horizontal Scroll */
    .services-section { padding: 5rem 0; background-color: var(--color-surface-container-lowest); position: relative; }
    @@media (min-width: 768px) { .services-section { padding: 7rem 0; } }
    .services-header { text-align: center; max-width: 42rem; margin: 0 auto 4rem auto; padding: 0 1rem; }
    .services-desc { font-family: var(--font-sans); font-size: 1.125rem; color: var(--color-on-surface-variant); margin: 0; }
    
    .h-scroll-section { position: relative; height: 250vh; margin-top: 3rem; width: 100vw; left: 50%; margin-left: -50vw; }
    .h-scroll-sticky { position: sticky; top: 0; height: 100vh; width: 100%; overflow: hidden; display: flex; align-items: center; background-color: rgba(255,255,255,0.5); backdrop-filter: blur(4px); border-top: 1px solid rgba(212, 196, 183, 0.2); border-bottom: 1px solid rgba(212, 196, 183, 0.2); z-index: 10; box-shadow: inset 0 2px 4px 0 rgba(0,0,0,0.05); }
    .h-scroll-track { display: flex; flex-wrap: nowrap; align-items: center; gap: 1.5rem; padding: 0 10vw; width: max-content; transition: transform 0.075s ease-out; will-change: transform; }
    @@media (min-width: 768px) { .h-scroll-track { gap: 2.5rem; padding: 0 15vw; } }
    
    .h-scroll-intro { width: 80vw; flex-shrink: 0; display: flex; flex-direction: column; justify-content: center; padding-right: 2rem; }
    @@media (min-width: 768px) { .h-scroll-intro { width: 400px; } }
    .h-scroll-intro-tag { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-primary); font-family: var(--font-sans); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 0.75rem; }
    .h-scroll-end { width: 20vw; flex-shrink: 0; }
    @@media (min-width: 768px) { .h-scroll-end { width: 100px; } }
    
    .service-card { width: 85vw; flex-shrink: 0; background-color: white; border-radius: 2rem; padding: 1.5rem; box-shadow: 0 8px 30px rgba(0,0,0,0.08); border: 1px solid rgba(212, 196, 183, 0.1); position: relative; overflow: hidden; height: 500px; display: flex; flex-direction: column; transform: translateY(0); transition: transform 0.3s; box-sizing: border-box; }
    @@media (min-width: 768px) { .service-card { width: 380px; } }
    .service-card:hover { transform: translateY(-0.5rem); }
    .service-img-wrapper { position: relative; height: 14rem; border-radius: 1rem; overflow: hidden; margin-bottom: 1.5rem; flex-shrink: 0; }
    .service-img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.7s ease-out; }
    .service-card:hover .service-img { transform: scale(1.1); }
    .service-badge { position: absolute; top: 1rem; left: 1rem; background-color: rgba(255,255,255,0.9); backdrop-filter: blur(12px); padding: 0.375rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-family: var(--font-sans); font-weight: 600; color: var(--color-primary); box-shadow: 0 1px 2px rgba(0,0,0,0.05); display: flex; align-items: center; gap: 0.375rem; }
    .service-price { font-family: var(--font-sans); color: var(--color-primary); margin-bottom: 1rem; margin-top: 0; font-weight: 700; font-size: 1.125rem; }
    .service-title { font-family: var(--font-sans); font-size: 1.25rem; color: var(--color-on-background); margin-bottom: 0.5rem; margin-top: 0; font-weight: 600; }
    .service-desc { font-family: var(--font-sans); font-size: 0.875rem; color: var(--color-on-surface-variant); margin-bottom: 1.5rem; flex-grow: 1; line-height: 1.625; }
    
    .service-actions { display: flex; align-items: center; gap: 1rem; margin-top: auto; }
    .service-btn-book { background-color: var(--color-primary-container); color: white; padding: 0.75rem 1.5rem; border-radius: 9999px; font-family: var(--font-sans); font-size: 0.875rem; font-weight: 600; text-align: center; flex-grow: 1; display: flex; justify-content: center; align-items: center; gap: 0.5rem; transition: background-color 0.3s; text-decoration: none; border: none; }
    .service-btn-book:hover { background-color: var(--color-primary); }
    .service-btn-details { width: 3rem; height: 3rem; border-radius: 9999px; border: 1px solid var(--color-outline-variant); display: flex; justify-content: center; align-items: center; color: var(--color-secondary); transition: all 0.3s; flex-shrink: 0; text-decoration: none; }
    .service-btn-details:hover { color: var(--color-primary); border-color: var(--color-primary); }
    
    .services-footer { margin-top: 3.5rem; text-align: center; }
    .btn-outline { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; border: 1px solid var(--color-primary-container); color: var(--color-primary-container); font-weight: 600; background: transparent; font-family: var(--font-sans); font-size: 0.875rem; padding: 0.875rem 2rem; border-radius: 9999px; transition: all 0.3s; text-decoration: none; }
    .btn-outline:hover { background-color: var(--color-primary-container); color: white; }

    /* Portfolio Gallery Section — Scroll-Pinned Step-by-Step */
    .portfolio-section { position: relative; height: 400vh; background-color: var(--color-surface-container-lowest); }
    .portfolio-sticky { position: sticky; top: 0; height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; overflow: hidden; padding: 1rem; }
    .portfolio-header { text-align: center; margin-bottom: 2rem; position: relative; z-index: 5; }
    .portfolio-subtitle { font-family: var(--font-sans); font-size: 1.125rem; color: var(--color-on-surface-variant); max-width: 600px; margin: 0 auto; line-height: 1.6; }
    .portfolio-stage { position: relative; width: 100%; max-width: 700px; aspect-ratio: 3/4; }
    @@media (min-width: 768px) { .portfolio-stage { max-width: 500px; } }
    .portfolio-card { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border-radius: 1.5rem; overflow: hidden; background-color: #111; border: 1px solid rgba(212, 196, 183, 0.2); box-shadow: 0 20px 60px rgba(0,0,0,0.15); opacity: 0; transform: scale(0.85) translateY(60px); transition: opacity 0.6s cubic-bezier(0.4,0,0.2,1), transform 0.6s cubic-bezier(0.4,0,0.2,1); will-change: opacity, transform; }
    .portfolio-card.active { opacity: 1; transform: scale(1) translateY(0); z-index: 3; }
    .portfolio-card.prev { opacity: 0.4; transform: scale(0.9) translateY(-30px); z-index: 2; }
    .portfolio-card-img { width: 100%; height: 100%; object-fit: contain; }
    .portfolio-card-overlay { position: absolute; bottom: 0; left: 0; right: 0; padding: 2.5rem 1.5rem 1.5rem; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%); display: flex; flex-direction: column; justify-content: flex-end; }
    .portfolio-card-label { font-family: var(--font-sans); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: rgba(255,255,255,0.8); margin-bottom: 0.25rem; }
    .portfolio-card-title { font-family: var(--font-display); font-size: 1.5rem; color: #fff; font-weight: 400; margin: 0; }
    .portfolio-dots { display: flex; gap: 0.75rem; margin-top: 1.5rem; position: relative; z-index: 5; }
    .portfolio-dot { width: 10px; height: 10px; border-radius: 9999px; background-color: rgba(212, 196, 183, 0.3); transition: all 0.4s ease; cursor: pointer; border: none; padding: 0; }
    .portfolio-dot.active { background-color: var(--color-primary); width: 28px; }

    /* CTA Section */
    .cta-section { padding: 5rem 1rem; background-color: var(--color-surface-container-high); position: relative; overflow: hidden; }
    @@media (min-width: 768px) { .cta-section { padding: 7rem 2rem; } }
    .cta-shape-1 { position: absolute; top: 0; right: 0; margin-top: -3rem; margin-right: -3rem; width: 24rem; height: 24rem; background-color: rgba(212, 163, 115, 0.05); border-radius: 9999px; filter: blur(48px); pointer-events: none; }
    .cta-shape-2 { position: absolute; bottom: 0; left: 0; margin-bottom: -3rem; margin-left: -3rem; width: 24rem; height: 24rem; background-color: rgba(245, 158, 11, 0.05); border-radius: 9999px; filter: blur(48px); pointer-events: none; }
    .cta-card { max-width: 56rem; margin: 0 auto; background-color: var(--color-surface); padding: 2.5rem; border-radius: 1.5rem; border: 1px solid rgba(212, 196, 183, 0.3); text-align: center; position: relative; z-index: 10; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1); }
    @@media (min-width: 768px) { .cta-card { padding: 4rem; } }
    .cta-checklist { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; margin-bottom: 2.5rem; font-size: 0.75rem; font-weight: 500; font-family: var(--font-sans); color: var(--color-on-surface-variant); }
    .cta-check-item { display: flex; align-items: center; gap: 0.5rem; }
    .cta-actions { display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 1rem; }
    @@media (min-width: 640px) { .cta-actions { flex-direction: row; } }
    .btn-cta-primary { width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; background-color: var(--color-primary-container); color: white; font-family: var(--font-sans); font-size: 0.875rem; font-weight: 600; padding: 1rem 2.25rem; border-radius: 9999px; transition: all 0.3s; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); text-decoration: none; border: none; }
    @@media (min-width: 640px) { .btn-cta-primary { width: auto; } }
    .btn-cta-primary:hover { background-color: var(--color-primary); }
    .btn-cta-secondary { width: 100%; display: flex; align-items: center; justify-content: center; gap: 0.5rem; border: 1px solid var(--color-primary-container); color: var(--color-primary-container); font-weight: 600; background: transparent; font-family: var(--font-sans); font-size: 0.875rem; padding: 1rem 2rem; border-radius: 9999px; transition: all 0.3s; text-decoration: none; }
    @@media (min-width: 640px) { .btn-cta-secondary { width: auto; } }
    .btn-cta-secondary:hover { background-color: rgba(212, 163, 115, 0.1); }
</style>

<div class="bg-background text-on-background">
    <!-- 1. HERO BANNER SECTION -->
    <section class="hero-section">
        <!-- Background Swiper Container -->
        <div class="swiper hero-swiper absolute inset-0 z-0 bg-surface-container w-full h-full">
            <div class="swiper-wrapper">
            @if (Model.Banners != null && Model.Banners.Any())
            {
                var sortedBanners = Model.Banners.OrderBy(b => b.SortOrder).ToList();
                for (int i = 0; i < sortedBanners.Count; i++)
                {
                    var banner = sortedBanners[i];
                    <div class="swiper-slide relative">
                        <!-- Image -->
                        <img src="@banner.ImageUrl" alt="@banner.Title" class="w-full h-full object-cover object-top" />
                        
                        <!-- Title Overlay -->
                        @if (!string.IsNullOrEmpty(banner.Title))
                        {
                            <div class="banner-title-container">
                                <h2 class="banner-title">
                                    @banner.Title
                                </h2>
                            </div>
                        }

                        <!-- Clickable Link Overlay -->
                        @if (!string.IsNullOrEmpty(banner.TargetUrl))
                        {
                            <a href="@banner.TargetUrl" class="absolute inset-0 z-20" aria-label="@banner.Title"></a>
                        }
                    </div>
                }
            }
            else
            {
                <div class="swiper-slide">
                    <img src="~/src/全家福妆容｜自然感亲子写真_1_SHIRLEY 专业化妝师 秒回信息！_来自小红书网页版.jpg" class="w-full h-full object-cover object-top" />
                </div>
            }
            </div>
            <!-- Swiper Pagination -->
            <div class="swiper-pagination"></div>
        </div>
        <!-- Gradient Overlay (kept separate from images for smooth fading) -->
        <div class="hero-overlay"></div>

        <!-- Scroll Indicator -->
        <button onclick="document.getElementById('about-artist').scrollIntoView({ behavior: 'smooth' })" class="scroll-indicator-btn">
            <span class="scroll-indicator-text">Scroll</span>
            <i data-lucide="chevron-down" class="w-5 h-5"></i>
        </button>
    </section>

    <!-- 2. ABOUT THE ARTIST SECTION -->
    <section id="about-artist" class="about-section">
        <div class="about-grid">

            <div data-aos="fade-left" class="about-content">
                <div class="section-header-tag">
                    <span class="section-header-line"></span>
                    <span>About the Artist</span>
                </div>
                <h2 class="section-title">
                    <span>Behind the Brush</span>
                </h2>
                <p class="about-desc">
                    <span>Based in the heart of Klang Valley, Malaysia, Shirley specializes in high-end bridal and editorial makeup. With a passion for precision and a calming presence, every session is designed to make you feel as exquisite as you look.</span>
                </p>

                <!-- Feature Pillars -->
                <div class="feature-grid">
