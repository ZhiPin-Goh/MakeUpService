            </div>
        </div>

        <!-- FAQ 6 -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary/30 shadow-xs">
            <button class="faq-toggle w-full text-left p-6 flex items-start justify-between gap-4 focus:outline-none group">
                <div class="flex flex-col gap-1.5">
                    <span class="inline-block self-start bg-primary-container/10 text-primary px-2.5 py-0.5 rounded-md font-label-md text-[11px] font-semibold">
                        <span>Modifications</span>
                    </span>
                    <h3 class="font-headline-md text-base md:text-lg text-on-background group-hover:text-primary transition-colors leading-snug">
                        <span>What should I do if I need to change the time or location of my appointment?</span>
                    </h3>
                </div>
                <div class="faq-icon p-2 rounded-full bg-surface-container/50 text-primary flex-shrink-0 transition-transform duration-300">
