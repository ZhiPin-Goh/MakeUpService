@{
    ViewData["Title"] = "FAQ";
}

<div class="px-margin-mobile md:px-margin-desktop py-12 md:py-20 max-w-5xl mx-auto">
    <!-- Header Banner -->
    <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="inline-flex items-center gap-2 text-secondary font-label-md text-xs uppercase tracking-widest mb-3">
            <i data-lucide="help-circle" class="w-4 h-4 text-primary"></i>
            <span>Help Center & FAQs</span>
        </span>
        <h1 class="font-display-lg-mobile text-display-lg-mobile md:font-display-lg md:text-display-lg text-primary mb-4">
            Frequently Asked Questions
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed">
            Everything you need to know about booking, trial sessions, products, travel, and skin preparation.
        </p>
    </div>

    <!-- Accordion FAQ List -->
    <div class="space-y-4 mb-16">
        <!-- FAQ 1 -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary/30 shadow-xs">
            <button class="faq-toggle w-full text-left p-6 flex items-start justify-between gap-4 focus:outline-none group">
                <div class="flex flex-col gap-1.5">
                    <span class="inline-block self-start bg-primary-container/10 text-primary px-2.5 py-0.5 rounded-md font-label-md text-[11px] font-semibold">
                        Booking & Trial
                    </span>
                    <h3 class="font-headline-md text-base md:text-lg text-on-background group-hover:text-primary transition-colors leading-snug">
                        How far in advance should I book my bridal makeup?
                    </h3>
                </div>
                <div class="faq-icon p-2 rounded-full bg-surface-container/50 text-primary flex-shrink-0 transition-transform duration-300">
                    <i data-lucide="chevron-down" class="w-5 h-5"></i>
                </div>
            </button>
            <div class="faq-content hidden px-6 pb-6 pt-1 text-on-surface-variant font-body-md text-sm md:text-base leading-relaxed border-t border-outline-variant/10">
                It is recommended to book 6 to 12 months in advance, especially for peak wedding seasons (October to February). Popular dates fill up quickly, but we also welcome last-minute inquiries subject to schedule availability.
            </div>
        </div>

        <!-- FAQ 2 -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary/30 shadow-xs">
            <button class="faq-toggle w-full text-left p-6 flex items-start justify-between gap-4 focus:outline-none group">
                <div class="flex flex-col gap-1.5">
                    <span class="inline-block self-start bg-primary-container/10 text-primary px-2.5 py-0.5 rounded-md font-label-md text-[11px] font-semibold">
                        Booking & Trial
                    </span>
                    <h3 class="font-headline-md text-base md:text-lg text-on-background group-hover:text-primary transition-colors leading-snug">
                        Is a makeup trial session included or recommended?
                    </h3>
                </div>
                <div class="faq-icon p-2 rounded-full bg-surface-container/50 text-primary flex-shrink-0 transition-transform duration-300">
                    <i data-lucide="chevron-down" class="w-5 h-5"></i>
                </div>
            </button>
            <div class="faq-content hidden px-6 pb-6 pt-1 text-on-surface-variant font-body-md text-sm md:text-base leading-relaxed border-t border-outline-variant/10">
                Trial sessions are highly recommended for brides to test skin compatibility, discuss style preferences, and refine your final look. Bridal trials can be booked separately or added as part of your bridal package at a discounted rate.
            </div>
        </div>

        <!-- FAQ 3 -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary/30 shadow-xs">
            <button class="faq-toggle w-full text-left p-6 flex items-start justify-between gap-4 focus:outline-none group">
                <div class="flex flex-col gap-1.5">
                    <span class="inline-block self-start bg-primary-container/10 text-primary px-2.5 py-0.5 rounded-md font-label-md text-[11px] font-semibold">
                        Services & Products
                    </span>
                    <h3 class="font-headline-md text-base md:text-lg text-on-background group-hover:text-primary transition-colors leading-snug">
                        What cosmetics and skincare brands do you use?
                    </h3>
                </div>
                <div class="faq-icon p-2 rounded-full bg-surface-container/50 text-primary flex-shrink-0 transition-transform duration-300">
                    <i data-lucide="chevron-down" class="w-5 h-5"></i>
                </div>
            </button>
            <div class="faq-content hidden px-6 pb-6 pt-1 text-on-surface-variant font-body-md text-sm md:text-base leading-relaxed border-t border-outline-variant/10">
                Shirley uses only premium luxury and high-performance brands including Charlotte Tilbury, Tom Ford, Dior Beauty, CHANEL, NARS, Laura Mercier, and Giorgio Armani. All products are long-wearing and HD photo-ready.
            </div>
        </div>
        
        <!-- FAQ 4 -->
        <div class="bg-surface-container-lowest border border-outline-variant/20 rounded-2xl overflow-hidden transition-all duration-300 hover:border-primary/30 shadow-xs">
            <button class="faq-toggle w-full text-left p-6 flex items-start justify-between gap-4 focus:outline-none group">
                <div class="flex flex-col gap-1.5">
                    <span class="inline-block self-start bg-primary-container/10 text-primary px-2.5 py-0.5 rounded-md font-label-md text-[11px] font-semibold">
                        Payment & Policy
                    </span>
                    <h3 class="font-headline-md text-base md:text-lg text-on-background group-hover:text-primary transition-colors leading-snug">
                        What is your cancellation or postponement policy?
                    </h3>
                </div>
                <div class="faq-icon p-2 rounded-full bg-surface-container/50 text-primary flex-shrink-0 transition-transform duration-300">
                    <i data-lucide="chevron-down" class="w-5 h-5"></i>
                </div>
            </button>
            <div class="faq-content hidden px-6 pb-6 pt-1 text-on-surface-variant font-body-md text-sm md:text-base leading-relaxed border-t border-outline-variant/10">
                Deposits are non-refundable. However, if you need to postpone due to unforeseen circumstances, your deposit can be transferred to a new available date within 12 months, provided at least 30 days’ advance notice is given.
            </div>
        </div>
    </div>

    <!-- Bottom Help Banner -->
    <div class="bg-surface-container-high rounded-3xl p-8 md:p-12 border border-outline-variant/20 text-center relative overflow-hidden shadow-md">
        <div class="relative z-10 max-w-2xl mx-auto">
            <div class="w-12 h-12 rounded-2xl bg-primary-container/10 text-primary flex items-center justify-center mx-auto mb-4">
                <i data-lucide="message-circle" class="w-6 h-6"></i>
            </div>
            <h3 class="font-headline-md text-headline-md text-primary mb-3">
                Still have unanswered questions?
            </h3>
            <p class="font-body-md text-on-surface-variant mb-8 text-sm md:text-base leading-relaxed">
                Our AI Beauty Assistant is available 24/7 to answer custom inquiries, or you can message Shirley directly on WhatsApp.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="/chat" class="w-full sm:w-auto bg-primary-container text-white px-8 py-3.5 rounded-full font-label-md text-xs flex items-center justify-center gap-2 shadow-sm hover:bg-primary-fixed hover:text-on-primary-fixed transition-all text-decoration-none">
                    <i data-lucide="sparkles" class="w-4 h-4"></i>
                    <span>Chat with Beauty AI</span>
                </a>
                <a href="https://wa.me/60123456789" target="_blank" rel="noopener noreferrer" class="w-full sm:w-auto bg-emerald-600 hover:bg-emerald-700 text-white px-8 py-3.5 rounded-full font-label-md text-xs flex items-center justify-center gap-2 shadow-sm transition-all text-decoration-none">
                    <i data-lucide="message-circle" class="w-4 h-4"></i>
                    <span>WhatsApp Us</span>
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.faq-toggle').on('click', function() {
                var $content = $(this).next('.faq-content');
                var $icon = $(this).find('.faq-icon');
                
                $content.slideToggle(300);
                $icon.toggleClass('rotate-180 bg-primary-container/10');
            });
        });
    </script>
}
